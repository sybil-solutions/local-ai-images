+// Small-M bf16 GEMV for Intel Xe2 decode: out[m, n] = sum_k x[m, k] * W[n, k], M <= MM.
+// One sub-group (16 lanes) owns R consecutive output rows n; per 128-element K chunk each lane
+// loads 8 bf16 (16 B, coalesced 256 B per row) of each of the R weight rows and the matching
+// x slices (L1-resident), accumulating in fp32. U chunks are unrolled so R*U loads are in flight.
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#include <type_traits>
+#include <torch/extension.h>
+
+namespace {
+
+constexpr int SG = 16;
+constexpr int CH = SG * 8;  // K elements per chunk
+
+inline float bf16f(uint16_t x) { return sycl::bit_cast<float>(uint32_t(x) << 16); }
+inline uint16_t f2bf(float f) {
+  uint32_t u = sycl::bit_cast<uint32_t>(f);
+  u += 0x7FFFu + ((u >> 16) & 1u);
+  return uint16_t(u >> 16);
+}
+using V8 = sycl::vec<uint16_t, 8>;
+
+template <int MM, int R, int NSG, int U, typename OT>
+struct Dense {
+  const uint16_t* x;
+  const uint16_t* w;
+  OT* out;
+  int M, N, K;
+  int64_t sx, sw, so;
+
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<1> it) const {
+    auto sg = it.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int n0 = (int(it.get_group(0)) * NSG + int(sg.get_group_linear_id())) * R;
+    if (n0 >= N) return;
+    const uint16_t* wr[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) wr[r] = w + int64_t(sycl::min(n0 + r, N - 1)) * sw + lane * 8;
+    const uint16_t* xr = x + lane * 8;
+    float acc[MM][R];
+#pragma unroll
+    for (int m = 0; m < MM; ++m)
+#pragma unroll
+      for (int r = 0; r < R; ++r) acc[m][r] = 0.f;
+    const int nch = K / CH;
+    int c = 0;
+    for (; c + U <= nch; c += U) {
+      V8 wv[U][R];
+#pragma unroll
+      for (int u = 0; u < U; ++u)
+#pragma unroll
+        for (int r = 0; r < R; ++r) wv[u][r] = *reinterpret_cast<const V8*>(wr[r] + (c + u) * CH);
+#pragma unroll
+      for (int u = 0; u < U; ++u) {
+#pragma unroll
+        for (int m = 0; m < MM; ++m) {
+          if (m < M) {
+            const V8 xv = *reinterpret_cast<const V8*>(xr + m * sx + (c + u) * CH);
+            float xf[8];
+#pragma unroll
+            for (int j = 0; j < 8; ++j) xf[j] = bf16f(xv[j]);
+#pragma unroll
+            for (int r = 0; r < R; ++r)
+#pragma unroll
+              for (int j = 0; j < 8; ++j) acc[m][r] = sycl::fma(xf[j], bf16f(wv[u][r][j]), acc[m][r]);
+          }
+        }
+      }
+    }
+    for (; c < nch; ++c) {
+      V8 wv[R];
+#pragma unroll
+      for (int r = 0; r < R; ++r) wv[r] = *reinterpret_cast<const V8*>(wr[r] + c * CH);
+#pragma unroll
+      for (int m = 0; m < MM; ++m) {
+        if (m < M) {
+          const V8 xv = *reinterpret_cast<const V8*>(xr + m * sx + c * CH);
+#pragma unroll
+          for (int r = 0; r < R; ++r)
+#pragma unroll
+            for (int j = 0; j < 8; ++j) acc[m][r] = sycl::fma(bf16f(xv[j]), bf16f(wv[r][j]), acc[m][r]);
+        }
+      }
+    }
+#pragma unroll
+    for (int m = 0; m < MM; ++m) {
+      if (m < M) {
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+          const float t = sycl::reduce_over_group(sg, acc[m][r], sycl::plus<float>());
+          if (lane == 0 && n0 + r < N) {
+            if constexpr (std::is_same_v<OT, float>) out[int64_t(m) * so + n0 + r] = t;
+            else out[int64_t(m) * so + n0 + r] = f2bf(t);
+          }
+        }
+      }
+    }
+  }
+};
+
+template <int MM, int R, int NSG, int U, typename OT>
+void run(sycl::queue& q, const torch::Tensor& x, const torch::Tensor& w, torch::Tensor& out) {
+  Dense<MM, R, NSG, U, OT> k{};
+  k.x = reinterpret_cast<const uint16_t*>(x.data_ptr());
+  k.w = reinterpret_cast<const uint16_t*>(w.data_ptr());
+  k.out = reinterpret_cast<OT*>(out.data_ptr());
+  k.M = x.size(0);
+  k.N = w.size(0);
+  k.K = w.size(1);
+  k.sx = x.stride(0);
+  k.sw = w.stride(0);
+  k.so = out.stride(0);
+  const int64_t groups = (k.N + NSG * R - 1) / (NSG * R);
+  q.parallel_for(sycl::nd_range<1>(groups * NSG * SG, NSG * SG), k);
+}
+
+}  // namespace
+
+// x [M, K] bf16 (row stride free, K contiguous), w [N, K] bf16 contiguous rows, out [M, N] bf16 or fp32
+void ink_dense(torch::Tensor x, torch::Tensor w, torch::Tensor out, int64_t mm, int64_t r, int64_t nsg, int64_t u) {
+  TORCH_CHECK(x.scalar_type() == at::kBFloat16 && w.scalar_type() == at::kBFloat16 &&
+              (out.scalar_type() == at::kBFloat16 || out.scalar_type() == at::kFloat));
+  const bool f32 = out.scalar_type() == at::kFloat;
+  TORCH_CHECK(x.dim() == 2 && w.dim() == 2 && out.dim() == 2 && x.stride(1) == 1 && w.stride(1) == 1 && out.stride(1) == 1);
+  TORCH_CHECK(x.size(1) == w.size(1) && w.size(1) % CH == 0 && x.size(0) <= mm, "K % 128 / M <= MM");
+  TORCH_CHECK(reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0 && reinterpret_cast<uintptr_t>(w.data_ptr()) % 16 == 0 &&
+                  x.stride(0) % 8 == 0 && w.stride(0) % 8 == 0,
+              "16B alignment");
+  auto& q = c10::xpu::getCurrentXPUStream().queue();
+#define DCASE(A, B, C, D)                     \
+  if (mm == A && r == B && nsg == C && u == D) { \
+    if (f32) run<A, B, C, D, float>(q, x, w, out); else run<A, B, C, D, uint16_t>(q, x, w, out); \
+    return;                                   \
+  }
+  DCASE(1, 2, 8, 2)
+  DCASE(1, 4, 8, 2)
+  DCASE(1, 2, 4, 3)
+  DCASE(1, 4, 4, 2)
+  DCASE(1, 1, 8, 4)
+  DCASE(1, 2, 8, 4)
+  DCASE(2, 2, 8, 2)
+  DCASE(2, 4, 4, 2)
+  DCASE(4, 2, 8, 2)
+  DCASE(4, 4, 4, 2)
+  DCASE(4, 2, 4, 3)
+  DCASE(8, 2, 8, 2)
+  DCASE(8, 4, 4, 1)
+  DCASE(8, 2, 4, 2)
+  DCASE(8, 4, 8, 1)
+  DCASE(8, 1, 8, 2)
+  DCASE(8, 2, 8, 1)
+  DCASE(8, 4, 4, 2)
+  DCASE(1, 4, 8, 1)
+  DCASE(16, 2, 4, 1)
+  DCASE(16, 1, 8, 2)
+#undef DCASE
+  TORCH_CHECK(false, "unsupported dense cfg mm=", mm, " r=", r, " nsg=", nsg, " u=", u);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("ink_dense", &ink_dense); }
diff --git a/python/sglang/kernels/ops/attention/xpu_sycl/ink_gemv.sycl b/python/sglang/kernels/ops/attention/xpu_sycl/ink_gemv.sycl
new file mode 100644
index 00000000..b048f964
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/xpu_sycl/ink_gemv.sycl
@@ -0,0 +1,195 @@
+// Routed-expert GEMV for Intel Xe2: out[row, n] = sum_k a[row / a_div, k] * W[e(row), n, k],
+// W NVFP4 (e2m1 nibbles, low nibble = even k, e4m3 scale per 16) or MXFP8 (e4m3, e8m0 scale
+// per 32). One sub-group computes R outputs of one row; lane l reads VB contiguous weight bytes
+// of each 16*VB-byte window (coalesced), decodes them with exact fp16 bit shifts (e2m1 * 2^-14,
+// e4m3 * 2^-8; the factors are undone once per output), and reuses its activation slice across
+// the R outputs. Rows whose expert id is outside [0, E) (another EP rank) are skipped.
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#include <torch/extension.h>
+
+namespace {
+
+constexpr int SG = 16;
+
+inline float bf16f(uint16_t x) { return sycl::bit_cast<float>(uint32_t(x) << 16); }
+inline uint16_t f2bf(float f) {
+  uint32_t u = sycl::bit_cast<uint32_t>(f);
+  u += 0x7FFFu + ((u >> 16) & 1u);
+  return uint16_t(u >> 16);
+}
+// e4m3 byte -> value * 2^-8 (fp16 bit shift, exact)
+inline float e4m3s(uint32_t b) {
+  return float(sycl::bit_cast<sycl::half>(uint16_t(((b & 0x7Fu) << 7) | ((b & 0x80u) << 8))));
+}
+inline float e8m0(uint32_t b) { return sycl::bit_cast<float>(b << 23); }
+
+// 4 packed fp4 bytes (8 codes) -> 8 floats * 2^-14, order k = 2i (low), 2i+1 (high)
+inline void fp4x8(uint32_t w, float* o) {
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const uint32_t b = (w >> (8 * i)) & 0xFFu;
+    const uint32_t h2 = ((b & 7u) << 9) | ((b & 8u) << 12) | ((b & 0x70u) << 21) | ((b & 0x80u) << 24);
+    auto v = sycl::bit_cast<sycl::vec<sycl::half, 2>>(h2);
+    o[2 * i] = float(v[0]);
+    o[2 * i + 1] = float(v[1]);
+  }
+}
+// 4 e4m3 bytes -> 4 floats * 2^-8
+inline void fp8x4(uint32_t x, float* o) {
+  uint32_t a = (x & 0xFFu) | ((x & 0xFF00u) << 8);
+  uint32_t b = ((x >> 16) & 0xFFu) | ((x >> 8) & 0xFF0000u);
+  auto ha = sycl::bit_cast<sycl::vec<sycl::half, 2>>(((a & 0x00800080u) << 8) | ((a & 0x007F007Fu) << 7));
+  auto hb = sycl::bit_cast<sycl::vec<sycl::half, 2>>(((b & 0x00800080u) << 8) | ((b & 0x007F007Fu) << 7));
+  o[0] = float(ha[0]);
+  o[1] = float(ha[1]);
+  o[2] = float(hb[0]);
+  o[3] = float(hb[1]);
+}
+
+// VB weight bytes per lane per window (multiple of 4). FP4: 2*VB elements, VB/8 scales (VB>=8)
+// or one scale shared by 8/VB lanes. FP8: VB elements, one scale per 32.
+template <bool FP4, int VB, int R, int NSG>
+struct Gemv {
+  const uint16_t* a;
+  const uint8_t* w;
+  const uint8_t* s;
+  uint16_t* out;
+  const int32_t* ids;
+  int E, N, K, a_div;
+  int64_t sa, so, swe, swn, sse, ssn;
+
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<2> it) const {
+    auto sg = it.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int row = it.get_group(0);
+    const int e = ids[row];
+    if (e < 0 || e >= E) return;
+    const int n0 = (it.get_group(1) * NSG + sg.get_group_linear_id()) * R;
+    if (n0 >= N) return;
+    constexpr int EL = FP4 ? 2 * VB : VB;  // elements per lane per window
+    const int64_t row_bytes = FP4 ? K / 2 : K;
+    const uint16_t* ar = a + int64_t(row / a_div) * sa;
+    const uint8_t* we = w + int64_t(e) * swe + int64_t(n0) * swn;
+    const uint8_t* se = s + int64_t(e) * sse + int64_t(n0) * ssn;
+    float acc[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) acc[r] = 0.f;
+    for (int64_t wb = int64_t(lane) * VB; wb < row_bytes; wb += SG * VB) {
+      const int64_t k0 = FP4 ? 2 * wb : wb;
+      float av[EL];
+#pragma unroll
+      for (int i = 0; i < EL; i += 8) {
+        sycl::vec<uint16_t, 8> v = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(ar + k0 + i);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) av[i + j] = bf16f(v[j]);
+      }
+#pragma unroll
+      for (int r = 0; r < R; ++r) {
+        const uint8_t* wr = we + int64_t(r) * swn + wb;
+        float part = 0.f;
+        if constexpr (FP4) {
+          // groups of 16 elements = 8 bytes
+#pragma unroll
+          for (int g = 0; g < (VB + 7) / 8; ++g) {
+            constexpr int GB = VB < 8 ? VB : 8;
+            float gs = 0.f;
+#pragma unroll
+            for (int q = 0; q < GB; q += 4) {
+              const uint32_t wv = *reinterpret_cast<const uint32_t*>(wr + g * 8 + q);
+              float f[8];
+              fp4x8(wv, f);
+#pragma unroll
+              for (int j = 0; j < 8; ++j) gs = sycl::fma(f[j], av[2 * (g * 8 + q) + j], gs);
+            }
+            part = sycl::fma(gs, e4m3s(se[int64_t(r) * ssn + (k0 + 16 * g) / 16]), part);
+          }
+        } else {
+          // groups of 32 elements; VB <= 32 so one scale per lane per window
+          float gs = 0.f;
+#pragma unroll
+          for (int q = 0; q < VB; q += 4) {
+            const uint32_t wv = *reinterpret_cast<const uint32_t*>(wr + q);
+            float f[4];
+            fp8x4(wv, f);
+#pragma unroll
+            for (int j = 0; j < 4; ++j) gs = sycl::fma(f[j], av[q + j], gs);
+          }
+          part = gs * e8m0(se[int64_t(r) * ssn + k0 / 32]);
+        }
+        acc[r] += part;
+      }
+    }
+    constexpr float UNDO = FP4 ? 4194304.f /* 2^22 */ : 256.f;
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+      const float t = sycl::reduce_over_group(sg, acc[r], sycl::plus<float>());
+      if (lane == r && n0 + r < N) out[int64_t(row) * so + n0 + r] = f2bf(t * UNDO);
+    }
+  }
+};
+
+template <bool FP4, int VB, int R, int NSG>
+void run(sycl::queue& q, const torch::Tensor& a, const torch::Tensor& w, const torch::Tensor& s, torch::Tensor& out,
+         const torch::Tensor& ids, int E, int N, int K, int a_div) {
+  Gemv<FP4, VB, R, NSG> k{};
+  k.a = reinterpret_cast<const uint16_t*>(a.data_ptr());
+  k.w = reinterpret_cast<const uint8_t*>(w.data_ptr());
+  k.s = reinterpret_cast<const uint8_t*>(s.data_ptr());
+  k.out = reinterpret_cast<uint16_t*>(out.data_ptr());
+  k.ids = ids.data_ptr<int32_t>();
+  k.E = E;
+  k.N = N;
+  k.K = K;
+  k.a_div = a_div;
+  k.sa = a.stride(0);
+  k.so = out.stride(0);
+  k.swe = w.stride(0);
+  k.swn = w.stride(1);
+  k.sse = s.stride(0);
+  k.ssn = s.stride(1);
+  const int64_t rows = ids.numel();
+  const int64_t ngroups = (N + NSG * R - 1) / (NSG * R);
+  sycl::range<2> local(1, NSG * SG), global(rows, ngroups * NSG * SG);
+  q.parallel_for(sycl::nd_range<2>(global, local), k);
+}
+
+}  // namespace
+
+// a [T, K] bf16; w [E, N, K/2] u8 (fp4) or [E, N, K] u8 (fp8); s [E, N, K/16|K/32] u8; ids [rows] int32
+void ink_gemv(torch::Tensor a, torch::Tensor w, torch::Tensor s, torch::Tensor out, torch::Tensor ids, bool fp4,
+              int64_t K, int64_t a_div, int64_t vb, int64_t r, int64_t nsg) {
+  TORCH_CHECK(a.scalar_type() == at::kBFloat16 && out.scalar_type() == at::kBFloat16, "a/out bf16");
+  TORCH_CHECK(a.stride(1) == 1 && w.stride(2) == 1 && s.stride(2) == 1 && out.stride(1) == 1, "contiguous K");
+  TORCH_CHECK(ids.scalar_type() == at::kInt, "ids int32");
+  const int E = w.size(0), N = w.size(1);
+  const int64_t row_bytes = fp4 ? K / 2 : K;
+  TORCH_CHECK(row_bytes % (SG * vb) == 0, "K bytes must be a multiple of 16*vb");
+  auto& q = c10::xpu::getCurrentXPUStream().queue();
+#define GEMV_CASE(F, V, RR, NS)                                         \
+  if (fp4 == F && vb == V && r == RR && nsg == NS) {                    \
+    run<F, V, RR, NS>(q, a, w, s, out, ids, E, N, int(K), int(a_div)); \
+    return;                                                             \
+  }
+  GEMV_CASE(true, 8, 4, 4)
+  GEMV_CASE(true, 8, 8, 4)
+  GEMV_CASE(true, 8, 2, 8)
+  GEMV_CASE(true, 8, 4, 8)
+  GEMV_CASE(true, 4, 4, 4)
+  GEMV_CASE(true, 4, 8, 4)
+  GEMV_CASE(true, 4, 2, 8)
+  GEMV_CASE(true, 4, 4, 8)
+  GEMV_CASE(true, 16, 4, 4)
+  GEMV_CASE(false, 16, 4, 4)
+  GEMV_CASE(false, 16, 8, 4)
+  GEMV_CASE(false, 16, 2, 8)
+  GEMV_CASE(false, 16, 4, 8)
+  GEMV_CASE(false, 8, 4, 4)
+  GEMV_CASE(false, 8, 8, 4)
+  GEMV_CASE(false, 8, 2, 8)
+  GEMV_CASE(false, 8, 4, 8)
+#undef GEMV_CASE
+  TORCH_CHECK(false, "unsupported gemv config fp4=", fp4, " vb=", vb, " r=", r, " nsg=", nsg);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("ink_gemv", &ink_gemv); }
diff --git a/python/sglang/kernels/ops/attention/xpu_sycl/ink_ggemv.sycl b/python/sglang/kernels/ops/attention/xpu_sycl/ink_ggemv.sycl
new file mode 100644
index 00000000..fdee97da
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/xpu_sycl/ink_ggemv.sycl
@@ -0,0 +1,290 @@
+// Expert-grouped routed GEMV for Intel Xe2 (decode with several tokens, MTP verify).
+// ink_group: one work-group buckets the routed rows by expert -> table (slot expert, start, count,
+//   row list, number of slots). ink_ggemv: one work-group per (slot, N tile); each sub-group decodes
+//   R weight rows of its expert once per K window (exact fp16 bit decode, as ink_gemv.sycl) and
+//   applies them to up to MAXR routed rows of that expert, so each expert's weights are read once
+//   per step instead of once per routed row.
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#include <torch/extension.h>
+
+namespace {
+
+constexpr int SG = 16;
+
+inline float bf16f(uint16_t x) { return sycl::bit_cast<float>(uint32_t(x) << 16); }
+inline uint16_t f2bf(float f) {
+  uint32_t u = sycl::bit_cast<uint32_t>(f);
+  u += 0x7FFFu + ((u >> 16) & 1u);
+  return uint16_t(u >> 16);
+}
+inline float e4m3s(uint32_t b) {
+  return float(sycl::bit_cast<sycl::half>(uint16_t(((b & 0x7Fu) << 7) | ((b & 0x80u) << 8))));
+}
+inline float e8m0(uint32_t b) { return sycl::bit_cast<float>(b << 23); }
+inline void fp4x8(uint32_t w, float* o) {
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const uint32_t b = (w >> (8 * i)) & 0xFFu;
+    const uint32_t h2 = ((b & 7u) << 9) | ((b & 8u) << 12) | ((b & 0x70u) << 21) | ((b & 0x80u) << 24);
+    auto v = sycl::bit_cast<sycl::vec<sycl::half, 2>>(h2);
+    o[2 * i] = float(v[0]);
+    o[2 * i + 1] = float(v[1]);
+  }
+}
+inline void fp8x4(uint32_t x, float* o) {
+  uint32_t a = (x & 0xFFu) | ((x & 0xFF00u) << 8);
+  uint32_t b = ((x >> 16) & 0xFFu) | ((x >> 8) & 0xFF0000u);
+  auto ha = sycl::bit_cast<sycl::vec<sycl::half, 2>>(((a & 0x00800080u) << 8) | ((a & 0x007F007Fu) << 7));
+  auto hb = sycl::bit_cast<sycl::vec<sycl::half, 2>>(((b & 0x00800080u) << 8) | ((b & 0x007F007Fu) << 7));
+  o[0] = float(ha[0]);
+  o[1] = float(ha[1]);
+  o[2] = float(hb[0]);
+  o[3] = float(hb[1]);
+}
+
+// table layout (int32): [0] = nslots, [1 + s] = expert, [1 + S + s] = start, [1 + 2S + s] = count,
+// [1 + 3S + i] = row list (rows grouped by slot). S = max slots = rows (capacity).
+constexpr int GROUP_WG = 256;
+constexpr int MAX_E = 512;
+
+struct Group {
+  const int32_t* ids;
+  int32_t* table;
+  int rows, E, S;
+  void run(sycl::nd_item<1> it, int32_t* cnt, int32_t* base) const {
+    const int t = it.get_local_linear_id();
+    for (int e = t; e < E; e += GROUP_WG) cnt[e] = 0;
+    sycl::group_barrier(it.get_group());
+    for (int i = t; i < rows; i += GROUP_WG) {
+      const int e = ids[i];
+      if (e >= 0 && e < E) {
+        sycl::atomic_ref<int32_t, sycl::memory_order::relaxed, sycl::memory_scope::work_group,
+                         sycl::access::address_space::generic_space>(cnt[e])
+            .fetch_add(1);
+      }
+    }
+    sycl::group_barrier(it.get_group());
+    if (t == 0) {  // E <= 512: a serial scan is ~1 us and keeps the slot order deterministic
+      int s = 0, start = 0;
+      for (int e = 0; e < E; ++e) {
+        const int c = cnt[e];
+        base[e] = start;
+        if (c) {
+          table[1 + s] = e;
+          table[1 + S + s] = start;
+          table[1 + 2 * S + s] = c;
+          ++s;
+          start += c;
+        }
+      }
+      table[0] = s;
+    }
+    sycl::group_barrier(it.get_group());
+    // rows in ascending order within each expert (deterministic): rank = #earlier rows, same expert
+    for (int i = t; i < rows; i += GROUP_WG) {
+      const int e = ids[i];
+      if (e >= 0 && e < E) {
+        int rank = 0;
+        for (int j = 0; j < i; ++j) rank += ids[j] == e;
+        table[1 + 3 * S + base[e] + rank] = i;
+      }
+    }
+  }
+};
+
+struct GroupK {
+  Group g;
+  sycl::local_accessor<int32_t, 1> cnt, base;
+  void operator()(sycl::nd_item<1> it) const {
+    g.run(it, cnt.get_multi_ptr<sycl::access::decorated::no>().get(), base.get_multi_ptr<sycl::access::decorated::no>().get());
+  }
+};
+
+template <bool FP4, int VB, int R, int NSG, int MAXR>
+struct GGemv {
+  const uint16_t* a;
+  const uint8_t* w;
+  const uint8_t* s;
+  uint16_t* out;
+  const int32_t* table;
+  int N, K, a_div, S;
+  int64_t sa, so, swe, swn, sse, ssn;
+
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<2> it) const {
+    auto sg = it.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int slot = it.get_group(0);
+    if (slot >= table[0]) return;
+    const int n0 = (it.get_group(1) * NSG + sg.get_group_linear_id()) * R;
+    if (n0 >= N) return;
+    const int e = table[1 + slot], start = table[1 + S + slot], count = table[1 + 2 * S + slot];
+    const int32_t* rl = table + 1 + 3 * S + start;
+    constexpr int EL = FP4 ? 2 * VB : VB;
+    const int64_t row_bytes = FP4 ? K / 2 : K;
+    const uint8_t* we = w + int64_t(e) * swe + int64_t(n0) * swn;
+    const uint8_t* se = s + int64_t(e) * sse + int64_t(n0) * ssn;
+    for (int c0 = 0; c0 < count; c0 += MAXR) {
+      const int nr = sycl::min(MAXR, count - c0);
+      const uint16_t* ar[MAXR];
+      int orow[MAXR];
+#pragma unroll
+      for (int i = 0; i < MAXR; ++i) {
+        orow[i] = rl[c0 + (i < nr ? i : 0)];
+        ar[i] = a + int64_t(orow[i] / a_div) * sa;
+      }
+      float acc[MAXR][R];
+#pragma unroll
+      for (int i = 0; i < MAXR; ++i)
+#pragma unroll
+        for (int r = 0; r < R; ++r) acc[i][r] = 0.f;
+      for (int64_t wb = int64_t(lane) * VB; wb < row_bytes; wb += SG * VB) {
+        const int64_t k0 = FP4 ? 2 * wb : wb;
+        // decoded, scaled weights for the R outputs (scale folded in: one multiply per element)
+        float wf[R][EL];
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+          const uint8_t* wr = we + int64_t(r) * swn + wb;
+          if constexpr (FP4) {
+#pragma unroll
+            for (int g = 0; g < (VB + 7) / 8; ++g) {
+              constexpr int GB = VB < 8 ? VB : 8;
+              const float sc = e4m3s(se[int64_t(r) * ssn + (k0 + 16 * g) / 16]);
+#pragma unroll
+              for (int q = 0; q < GB; q += 4) {
+                const uint32_t wv = *reinterpret_cast<const uint32_t*>(wr + g * 8 + q);
+                float f[8];
+                fp4x8(wv, f);
+#pragma unroll
+                for (int j = 0; j < 8; ++j) wf[r][2 * (g * 8 + q) + j] = f[j] * sc;
+              }
+            }
+          } else {
+            const float sc = e8m0(se[int64_t(r) * ssn + k0 / 32]);
+#pragma unroll
+            for (int q = 0; q < VB; q += 4) {
+              const uint32_t wv = *reinterpret_cast<const uint32_t*>(wr + q);
+              float f[4];
+              fp8x4(wv, f);
+#pragma unroll
+              for (int j = 0; j < 4; ++j) wf[r][q + j] = f[j] * sc;
+            }
+          }
+        }
+#pragma unroll
+        for (int i = 0; i < MAXR; ++i) {
+          if (i < nr) {
+            float av[EL];
+#pragma unroll
+            for (int q = 0; q < EL; q += 8) {
+              sycl::vec<uint16_t, 8> v = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(ar[i] + k0 + q);
+#pragma unroll
+              for (int j = 0; j < 8; ++j) av[q + j] = bf16f(v[j]);
+            }
+#pragma unroll
+            for (int r = 0; r < R; ++r)
+#pragma unroll
+              for (int j = 0; j < EL; ++j) acc[i][r] = sycl::fma(wf[r][j], av[j], acc[i][r]);
+          }
+        }
+      }
+      constexpr float UNDO = FP4 ? 4194304.f : 256.f;
+#pragma unroll
+      for (int i = 0; i < MAXR; ++i) {
+        if (i < nr) {
+#pragma unroll
+          for (int r = 0; r < R; ++r) {
+            const float t = sycl::reduce_over_group(sg, acc[i][r], sycl::plus<float>());
+            if (lane == r && n0 + r < N) out[int64_t(orow[i]) * so + n0 + r] = f2bf(t * UNDO);
+          }
+        }
+      }
+    }
+  }
+};
+
+template <bool FP4, int VB, int R, int NSG, int MAXR>
+void run(sycl::queue& q, const torch::Tensor& a, const torch::Tensor& w, const torch::Tensor& s, torch::Tensor& out,
+         const torch::Tensor& table, int S, int N, int K, int a_div) {
+  GGemv<FP4, VB, R, NSG, MAXR> k{};
+  k.a = reinterpret_cast<const uint16_t*>(a.data_ptr());
+  k.w = reinterpret_cast<const uint8_t*>(w.data_ptr());
+  k.s = reinterpret_cast<const uint8_t*>(s.data_ptr());
+  k.out = reinterpret_cast<uint16_t*>(out.data_ptr());
+  k.table = table.data_ptr<int32_t>();
+  k.N = N;
+  k.K = K;
+  k.a_div = a_div;
+  k.S = S;
+  k.sa = a.stride(0);
+  k.so = out.stride(0);
+  k.swe = w.stride(0);
+  k.swn = w.stride(1);
+  k.sse = s.stride(0);
+  k.ssn = s.stride(1);
+  const int64_t ngroups = (N + NSG * R - 1) / (NSG * R);
+  const int64_t slots = std::min<int64_t>(S, w.size(0));
+  sycl::range<2> local(1, NSG * SG), global(slots, ngroups * NSG * SG);
+  q.parallel_for(sycl::nd_range<2>(global, local), k);
+}
+
+}  // namespace
+
+// ids [rows] int32 local expert ids (outside [0, E) = skip); table int32 [1 + 3*rows + rows]
+void ink_group(torch::Tensor ids, torch::Tensor table, int64_t E) {
+  TORCH_CHECK(ids.scalar_type() == at::kInt && table.scalar_type() == at::kInt && E <= MAX_E);
+  const int rows = ids.numel();
+  TORCH_CHECK(table.numel() >= 1 + 4 * rows, "table too small");
+  auto& q = c10::xpu::getCurrentXPUStream().queue();
+  Group g{ids.data_ptr<int32_t>(), table.data_ptr<int32_t>(), rows, int(E), rows};
+  q.submit([&](sycl::handler& h) {
+    sycl::local_accessor<int32_t, 1> cnt(MAX_E, h), base(MAX_E, h);
+    h.parallel_for(sycl::nd_range<1>(GROUP_WG, GROUP_WG), GroupK{g, cnt, base});
+  });
+}
+
+void ink_ggemv(torch::Tensor a, torch::Tensor w, torch::Tensor s, torch::Tensor out, torch::Tensor table, int64_t rows,
+               bool fp4, int64_t K, int64_t a_div, int64_t vb, int64_t r, int64_t nsg, int64_t maxr) {
+  TORCH_CHECK(a.scalar_type() == at::kBFloat16 && out.scalar_type() == at::kBFloat16, "a/out bf16");
+  TORCH_CHECK(a.stride(1) == 1 && w.stride(2) == 1 && s.stride(2) == 1 && out.stride(1) == 1, "contiguous K");
+  const int N = w.size(1);
+  const int64_t row_bytes = fp4 ? K / 2 : K;
+  TORCH_CHECK(row_bytes % vb == 0 && row_bytes >= SG * vb, "K bytes: multiple of vb, >= 16*vb (the lane loop takes a partial last window)");
+  auto& q = c10::xpu::getCurrentXPUStream().queue();
+#define GG(F, V, RR, NS, MR)                                                              \
+  if (fp4 == F && vb == V && r == RR && nsg == NS && maxr == MR) {                       \
+    run<F, V, RR, NS, MR>(q, a, w, s, out, table, int(rows), N, int(K), int(a_div)); \
+    return;                                                                             \
+  }
+  GG(true, 8, 2, 4, 4)
+  GG(true, 8, 2, 4, 8)
+  GG(true, 8, 4, 4, 4)
+  GG(true, 8, 2, 8, 4)
+  GG(true, 8, 1, 8, 8)
+  GG(true, 4, 2, 8, 8)
+  GG(true, 4, 4, 4, 8)
+  GG(true, 8, 4, 8, 4)
+  GG(true, 8, 2, 8, 2)
+  GG(true, 8, 4, 4, 2)
+  GG(true, 8, 8, 4, 2)
+  GG(true, 8, 8, 2, 4)
+  GG(true, 8, 4, 2, 4)
+  GG(true, 8, 4, 8, 2)
+  GG(true, 8, 4, 8, 8)
+  GG(true, 8, 4, 16, 4)
+  GG(true, 8, 2, 16, 4)
+  GG(true, 8, 4, 16, 2)
+  GG(false, 16, 2, 4, 4)
+  GG(false, 16, 2, 4, 8)
+  GG(false, 16, 1, 8, 8)
+  GG(false, 8, 2, 4, 8)
+  GG(false, 8, 4, 4, 8)
+  GG(false, 8, 2, 8, 4)
+#undef GG
+  TORCH_CHECK(false, "unsupported ggemv config fp4=", fp4, " vb=", vb, " r=", r, " nsg=", nsg, " maxr=", maxr);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("ink_group", &ink_group);
+  m.def("ink_ggemv", &ink_ggemv);
+}
diff --git a/python/sglang/kernels/ops/attention/xpu_sycl/ink_router.sycl b/python/sglang/kernels/ops/attention/xpu_sycl/ink_router.sycl
new file mode 100644
index 00000000..14bc874e
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/xpu_sycl/ink_router.sycl
@@ -0,0 +1,138 @@
+// Inkling2 decode router in one launch (Intel Xe2): FP32 logits[t, e] = x[t] . W[e] over
+// NG work-groups per token (one sub-group per expert row), then the last work-group to finish
+// (device-scope counter, reset by itself) does the stable descending top-k of
+// sigmoid(logits) + bias and weights = sigmoid(chosen) / sum * scale (= _router_select).
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#include <torch/extension.h>
+
+namespace {
+
+constexpr int SG = 16;
+
+inline float bf16f(uint16_t x) { return sycl::bit_cast<float>(uint32_t(x) << 16); }
+inline float sigm(float x) { return 1.f / (1.f + sycl::exp(-x)); }
+
+template <int E, int TOPK, int NSG>
+struct Router {
+  const uint16_t* x;
+  const uint16_t* w;
+  const float* bias;  // nullptr = none
+  float* logits;      // [T, E]
+  int32_t* counter;   // [T], zero between launches
+  int32_t* ids;       // [T, TOPK]
+  float* weights;     // [T, TOPK]
+  int K;
+  int64_t sx;
+  float scale;
+
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<2> it) const {
+    auto sg = it.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int t = it.get_group(0);
+    const int ng = it.get_group_range(1);
+    // one work-group per expert row; its NSG sub-groups split the K chunks of 128
+    const int e = it.get_group(1);
+    const int sgid = sg.get_group_linear_id();
+    const uint16_t* xr = x + int64_t(t) * sx;
+    const uint16_t* wr = w + int64_t(e) * K;
+    float acc = 0.f;
+    for (int k = (sgid * SG + lane) * 8; k < K; k += NSG * SG * 8) {
+      const auto xv = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(xr + k);
+      const auto wv = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(wr + k);
+#pragma unroll
+      for (int j = 0; j < 8; ++j) acc = sycl::fma(bf16f(xv[j]), bf16f(wv[j]), acc);
+    }
+    acc = sycl::reduce_over_group(it.get_group(), acc, sycl::plus<float>());
+    if (it.get_local_linear_id() == 0) logits[int64_t(t) * E + e] = acc;
+    sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::device);
+    sycl::group_barrier(it.get_group());
+    // last work-group of this token selects; the group shares the vote through a broadcast
+    int last = 0;
+    if (it.get_local_linear_id() == 0) {
+      sycl::atomic_ref<int32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
+                       sycl::access::address_space::global_space>
+          c(counter[t]);
+      last = c.fetch_add(1) == ng - 1;
+    }
+    last = sycl::group_broadcast(it.get_group(), last, 0);
+    if (!last || sg.get_group_linear_id() != 0) return;
+    sycl::atomic_fence(sycl::memory_order::acquire, sycl::memory_scope::device);
+    constexpr int PER = E / SG;
+    float lg[PER], sel[PER];
+#pragma unroll
+    for (int i = 0; i < PER; ++i) {
+      const int ei = i * SG + lane;
+      sycl::atomic_ref<float, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                       sycl::access::address_space::global_space>
+          a(logits[int64_t(t) * E + ei]);
+      lg[i] = a.load();
+      sel[i] = sigm(lg[i]) + (bias != nullptr ? bias[ei] : 0.f);
+    }
+    float chosen[TOPK];
+    int cid[TOPK];
+#pragma unroll
+    for (int r = 0; r < TOPK; ++r) {
+      float best = -INFINITY;
+#pragma unroll
+      for (int i = 0; i < PER; ++i) best = sycl::fmax(best, sel[i]);
+      best = sycl::reduce_over_group(sg, best, sycl::maximum<float>());
+      int idx = E;
+#pragma unroll
+      for (int i = 0; i < PER; ++i)
+        if (sel[i] == best) idx = sycl::min(idx, i * SG + lane);
+      idx = sycl::reduce_over_group(sg, idx, sycl::minimum<int>());
+      float l = 0.f;
+#pragma unroll
+      for (int i = 0; i < PER; ++i)
+        if (i * SG + lane == idx) {
+          l = lg[i];
+          sel[i] = -INFINITY;
+        }
+      chosen[r] = sycl::reduce_over_group(sg, l, sycl::plus<float>());
+      cid[r] = idx;
+    }
+    if (lane == 0) {
+      float sum = 0.f, sg8[TOPK];
+#pragma unroll
+      for (int r = 0; r < TOPK; ++r) {
+        sg8[r] = sigm(chosen[r]);
+        sum += sg8[r];
+      }
+#pragma unroll
+      for (int r = 0; r < TOPK; ++r) {
+        ids[int64_t(t) * TOPK + r] = cid[r];
+        weights[int64_t(t) * TOPK + r] = sg8[r] / sum * scale;
+      }
+      counter[t] = 0;
+    }
+  }
+};
+
+}  // namespace
+
+void ink_router(torch::Tensor x, torch::Tensor w, c10::optional<torch::Tensor> bias, torch::Tensor logits,
+                torch::Tensor counter, torch::Tensor ids, torch::Tensor weights, double scale) {
+  const int T = x.size(0), K = x.size(1), E = w.size(0);
+  TORCH_CHECK(x.scalar_type() == at::kBFloat16 && w.scalar_type() == at::kBFloat16 && x.stride(1) == 1 && w.is_contiguous());
+  TORCH_CHECK(K % (SG * 8) == 0 && x.stride(0) % 8 == 0, "K");
+  TORCH_CHECK(E == 128 && ids.size(1) == 8, "E=128 top-8 only");
+  TORCH_CHECK(counter.scalar_type() == at::kInt && counter.numel() >= T && logits.scalar_type() == at::kFloat);
+  if (bias.has_value()) TORCH_CHECK(bias->scalar_type() == at::kFloat && bias->numel() == E);
+  constexpr int NSG = 6;
+  Router<128, 8, NSG> k{};
+  k.x = reinterpret_cast<const uint16_t*>(x.data_ptr());
+  k.w = reinterpret_cast<const uint16_t*>(w.data_ptr());
+  k.bias = bias.has_value() ? bias->data_ptr<float>() : nullptr;
+  k.logits = logits.data_ptr<float>();
+  k.counter = counter.data_ptr<int32_t>();
+  k.ids = ids.data_ptr<int32_t>();
+  k.weights = weights.data_ptr<float>();
+  k.K = K;
+  k.sx = x.stride(0);
+  k.scale = float(scale);
+  auto& q = c10::xpu::getCurrentXPUStream().queue();
+  q.parallel_for(sycl::nd_range<2>(sycl::range<2>(T, E * NSG * SG), sycl::range<2>(1, NSG * SG)), k);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("ink_router", &ink_router); }
diff --git a/python/sglang/kernels/ops/attention/xpu_sycl/ink_verify.sycl b/python/sglang/kernels/ops/attention/xpu_sycl/ink_verify.sycl
new file mode 100644
index 00000000..7d107068
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/xpu_sycl/ink_verify.sycl
@@ -0,0 +1,285 @@
+// Speculative-verify prefix attention for Intel Xe2 (Arc Pro B70): drop-in for the Triton
+// _ink_verify_prefix (kernels/ops/attention/inkling_verify.py), writing the same split partials
+// for its _ink_verify_merge. fp8 e4m3 KV, head dim 128, G = 3 q heads per kv head, N draft tokens.
+//
+// One work-group per (request, kv head, split) with N sub-groups: sub-group t owns draft token t
+// (its G query rows) and runs the ink_decode inner loop over the split's keys. All N sub-groups walk
+// the same 16-key chunks, so the prefix is read from memory about once and served to the other
+// sub-groups from the Xe core's L1. Per-row limits: the sliding window (q_pos - k_pos <= SW) and the
+// relative bias (q_pos - k_pos < rel_len), with q_pos = off + L + t and k_pos = off + n.
+//
+// Partials (natural log, as the Triton kernel): Part_O[(slot*BM + r), D] = unnormalized acc * v_scale,
+// Part_M = running max, Part_L = running sum, slot = (b*KVH + kh)*NSPLIT + split, r = t*G + h.
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#ifdef INK_GRF256
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+#endif
+#include <torch/extension.h>
+
+namespace {
+
+constexpr int SG = 16;
+constexpr int D = 128;
+constexpr int DL = D / SG;
+constexpr int G = 3;
+constexpr float NEG_INF = -INFINITY;
+constexpr float NEG = -1e30f;  // finite "no key yet" max: the math never depends on IEEE inf
+constexpr float LN2 = 0.6931471805599453f;
+
+inline float bf16_to_f32(uint16_t x) { return sycl::bit_cast<float>(uint32_t(x) << 16); }
+
+// 4 fp8 e4m3 bytes -> 4 floats scaled by 2^-8 (exact, subnormals included).
+inline void cvt4(uint32_t x, float* o) {
+  uint32_t a = (x & 0xFFu) | ((x & 0xFF00u) << 8);
+  uint32_t b = ((x >> 16) & 0xFFu) | ((x >> 8) & 0xFF0000u);
+  uint32_t ha = ((a & 0x00800080u) << 8) | ((a & 0x007F007Fu) << 7);
+  uint32_t hb = ((b & 0x00800080u) << 8) | ((b & 0x007F007Fu) << 7);
+  auto h2a = sycl::bit_cast<sycl::vec<sycl::half, 2>>(ha);
+  auto h2b = sycl::bit_cast<sycl::vec<sycl::half, 2>>(hb);
+  o[0] = float(h2a[0]);
+  o[1] = float(h2a[1]);
+  o[2] = float(h2b[0]);
+  o[3] = float(h2b[1]);
+}
+
+inline void cvt8(sycl::vec<uint32_t, 2> r, float* o) {
+  cvt4(r[0], o);
+  cvt4(r[1], o + 4);
+}
+
+template <typename IDX, int N, bool HAS_REL, bool HAS_OFF>
+struct InkVerify {
+  const uint16_t* q;
+  const uint8_t* k;
+  const uint8_t* v;
+  const int32_t* kv_indptr;
+  const IDX* kv_indices;
+  const int64_t* kv_offsets;
+  const uint16_t* rel;
+  float* part_o;
+  float* part_m;
+  float* part_l;
+  int64_t sqt, sqh, skt, skh, svt, svh, srt, srh;
+  int rel_len, nsplit, kvh, block_m, sw;
+  float scale_log2, rel_log2, out_scale;
+
+#ifdef INK_GRF256
+  // 256-register mode: the 16-key K/V chunk + 3x16 scores + q/acc rows exceed the default 128 GRF
+  auto get(sycl::ext::oneapi::experimental::properties_tag) const {
+    return sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+  }
+#endif
+
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<3> it) const {
+    auto sg = it.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int t = sg.get_group_linear_id();  // draft token
+    const int64_t b = it.get_group(0);
+    const int g = it.get_group(1);
+    const int s = it.get_group(2);
+
+    const int kv_start = kv_indptr[b];
+    const int L = kv_indptr[b + 1] - kv_start;
+    const int per = (L + nsplit - 1) / nsplit;
+    const int lo = sycl::min(s * per, L);
+    const int hi = sycl::min(lo + per, L);
+    const int64_t qrow = b * N + t;
+    const int qd = L + t;  // q_pos - off; the distance to key n is qd - n
+
+    float qf[G][DL];
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+      const uint16_t* qp = q + qrow * sqt + int64_t(g * G + h) * sqh + lane * DL;
+      sycl::vec<uint16_t, 8> qv = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(qp);
+#pragma unroll
+      for (int d = 0; d < DL; ++d) qf[h][d] = bf16_to_f32(qv[d]) * scale_log2;
+    }
+    float m[G], lsum[G], acc[G][DL];
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+      m[h] = NEG;
+      lsum[h] = 0.f;
+#pragma unroll
+      for (int d = 0; d < DL; ++d) acc[h][d] = 0.f;
+    }
+    const uint8_t* kb = k + int64_t(g) * skh + lane * DL;
+    const uint8_t* vb = v + int64_t(g) * svh + lane * DL;
+    const IDX* idx = kv_indices + kv_start;
+    // keys this token can see: n >= qd - sw (window), n < hi
+    const int nmin = sw >= 0 ? sycl::max(lo, qd - sw) : lo;
+
+    for (int c = lo; c < hi; c += SG) {
+      if (c + SG <= nmin) continue;  // whole chunk outside this token's window
+      const int n = c + lane;
+      const bool valid = n < hi && n >= nmin;
+      const int64_t slot = int64_t(idx[n < hi ? n : c]);
+      sycl::vec<uint32_t, 2> kr[SG], vr[SG];
+#pragma unroll
+      for (int j = 0; j < SG; ++j) {
+        const int64_t sj = sycl::select_from_group(sg, slot, j);
+        kr[j] = *reinterpret_cast<const sycl::vec<uint32_t, 2>*>(kb + sj * skt);
+        vr[j] = *reinterpret_cast<const sycl::vec<uint32_t, 2>*>(vb + sj * svt);
+      }
+      float sc[G][SG];
+#pragma unroll
+      for (int j = 0; j < SG; ++j) {
+        float kf[DL];
+        cvt8(kr[j], kf);
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+          float a = 0.f;
+#pragma unroll
+          for (int d = 0; d < DL; ++d) a = sycl::fma(qf[h][d], kf[d], a);
+          sc[h][j] = a;
+        }
+      }
+#pragma unroll
+      for (int w = SG / 2; w >= 1; w /= 2) {
+        const bool up = lane & w;
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+#pragma unroll
+          for (int i = 0; i < w; ++i) {
+            const float keep = up ? sc[h][w + i] : sc[h][i];
+            const float send = up ? sc[h][i] : sc[h][w + i];
+            sc[h][i] = keep + sycl::permute_group_by_xor(sg, send, w);
+          }
+        }
+      }
+      float p[G];
+#pragma unroll
+      for (int h = 0; h < G; ++h) {
+        float sv = valid ? sc[h][0] : NEG;
+        if constexpr (HAS_REL) {
+          const int dist = qd - n;
+          if (valid && dist < rel_len)
+            sv += bf16_to_f32(rel[qrow * srt + int64_t(g * G + h) * srh + dist]) * rel_log2;
+        }
+        const float mt = sycl::reduce_over_group(sg, sv, sycl::maximum<float>());
+        const float mn = sycl::fmax(m[h], mt);
+        const float alpha = sycl::exp2(m[h] - mn);  // both finite; 1 while no key has been seen (acc = 0)
+        p[h] = valid ? sycl::exp2(sv - mn) : 0.f;
+        lsum[h] = lsum[h] * alpha + p[h];
+        m[h] = mn;
+#pragma unroll
+        for (int d = 0; d < DL; ++d) acc[h][d] *= alpha;
+      }
+#pragma unroll
+      for (int j = 0; j < SG; ++j) {
+        float vf[DL];
+        cvt8(vr[j], vf);
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+          const float pj = sycl::select_from_group(sg, p[h], j);
+#pragma unroll
+          for (int d = 0; d < DL; ++d) acc[h][d] = sycl::fma(pj, vf[d], acc[h][d]);
+        }
+      }
+    }
+    const int64_t base = ((b * kvh + g) * int64_t(nsplit) + s) * block_m;
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+      const float l = sycl::reduce_over_group(sg, lsum[h], sycl::plus<float>());
+      const int64_t r = base + t * G + h;
+      sycl::vec<float, 8> ov;
+#pragma unroll
+      for (int d = 0; d < DL; ++d) ov[d] = acc[h][d] * out_scale;
+      *reinterpret_cast<sycl::vec<float, 8>*>(part_o + r * D + lane * DL) = ov;
+      if (lane == 0) {
+        part_m[r] = l > 0.f ? m[h] * LN2 : NEG_INF;  // no visible key in this split
+        part_l[r] = l;
+      }
+    }
+  }
+};
+
+template <typename IDX, int N, bool REL, bool OFF>
+void run(sycl::queue& qu, const torch::Tensor& q, const torch::Tensor& k, const torch::Tensor& v,
+         const torch::Tensor& kv_indptr, const torch::Tensor& kv_indices, const c10::optional<torch::Tensor>& off,
+         const c10::optional<torch::Tensor>& rel, torch::Tensor& po, torch::Tensor& pm, torch::Tensor& pl, int nsplit,
+         int block_m, int sw, float sc, float os) {
+  InkVerify<IDX, N, REL, OFF> kr{};
+  const int bs = q.size(0) / N;
+  const int kvh = k.size(1);
+  kr.q = reinterpret_cast<const uint16_t*>(q.data_ptr());
+  kr.k = reinterpret_cast<const uint8_t*>(k.data_ptr());
+  kr.v = reinterpret_cast<const uint8_t*>(v.data_ptr());
+  kr.kv_indptr = kv_indptr.data_ptr<int32_t>();
+  kr.kv_indices = reinterpret_cast<const IDX*>(kv_indices.data_ptr());
+  kr.kv_offsets = OFF ? off->data_ptr<int64_t>() : nullptr;
+  kr.rel = REL ? reinterpret_cast<const uint16_t*>(rel->data_ptr()) : nullptr;
+  kr.part_o = po.data_ptr<float>();
+  kr.part_m = pm.data_ptr<float>();
+  kr.part_l = pl.data_ptr<float>();
+  kr.sqt = q.stride(0);
+  kr.sqh = q.stride(1);
+  kr.skt = k.stride(0);
+  kr.skh = k.stride(1);
+  kr.svt = v.stride(0);
+  kr.svh = v.stride(1);
+  kr.srt = REL ? rel->stride(0) : 0;
+  kr.srh = REL ? rel->stride(1) : 0;
+  kr.rel_len = REL ? rel->size(2) : 0;
+  kr.nsplit = nsplit;
+  kr.kvh = kvh;
+  kr.block_m = block_m;
+  kr.sw = sw;
+  kr.scale_log2 = sc;
+  kr.rel_log2 = 1.4426950408889634f;
+  kr.out_scale = os;
+  qu.parallel_for(sycl::nd_range<3>(sycl::range<3>(bs, kvh, nsplit * N * SG), sycl::range<3>(1, 1, N * SG)), kr);
+}
+
+template <typename IDX, int N>
+void by_flags(sycl::queue& qu, const torch::Tensor& q, const torch::Tensor& k, const torch::Tensor& v,
+              const torch::Tensor& ip, const torch::Tensor& ix, const c10::optional<torch::Tensor>& off,
+              const c10::optional<torch::Tensor>& rel, torch::Tensor& po, torch::Tensor& pm, torch::Tensor& pl, int ns,
+              int bm, int sw, float sc, float os) {
+  const bool R = rel.has_value(), O = off.has_value();
+  if (R && O) run<IDX, N, true, true>(qu, q, k, v, ip, ix, off, rel, po, pm, pl, ns, bm, sw, sc, os);
+  else if (R) run<IDX, N, true, false>(qu, q, k, v, ip, ix, off, rel, po, pm, pl, ns, bm, sw, sc, os);
+  else if (O) run<IDX, N, false, true>(qu, q, k, v, ip, ix, off, rel, po, pm, pl, ns, bm, sw, sc, os);
+  else run<IDX, N, false, false>(qu, q, k, v, ip, ix, off, rel, po, pm, pl, ns, bm, sw, sc, os);
+}
+
+}  // namespace
+
+// q [bs*N, H, 128] bf16; k/v cache [slots, KVH, 128] fp8; kv_indptr int32 [bs+1]; kv_indices int32/int64;
+// kv_offsets int64 [bs] or None (rail start positions); rel [bs*N, H, R] bf16 or None;
+// part_o fp32 [bs*KVH*nsplit*block_m*128], part_m/part_l fp32 [bs*KVH*nsplit*block_m].
+// sm_scale includes k_scale; v_scale scales the partial outputs.
+void ink_verify_prefix(torch::Tensor q, torch::Tensor k, torch::Tensor v, torch::Tensor kv_indptr,
+                       torch::Tensor kv_indices, c10::optional<torch::Tensor> kv_offsets, c10::optional<torch::Tensor> rel,
+                       torch::Tensor part_o, torch::Tensor part_m, torch::Tensor part_l, int64_t n_tokens, int64_t nsplit,
+                       int64_t block_m, int64_t sw, double sm_scale, double v_scale) {
+  TORCH_CHECK(q.scalar_type() == at::kBFloat16 && q.dim() == 3 && q.size(2) == D && q.stride(2) == 1, "q bf16 [T,H,128]");
+  TORCH_CHECK(k.element_size() == 1 && v.element_size() == 1 && k.dim() == 3 && k.stride(2) == 1 && v.stride(2) == 1,
+              "k/v fp8 [slots,KVH,128]");
+  TORCH_CHECK(q.size(1) == G * k.size(1), "3 q heads per kv head");
+  TORCH_CHECK(kv_indptr.scalar_type() == at::kInt, "kv_indptr int32");
+  TORCH_CHECK(q.size(0) % n_tokens == 0 && n_tokens * G <= block_m, "tokens");
+  if (rel) TORCH_CHECK(rel->scalar_type() == at::kBFloat16 && rel->dim() == 3 && rel->stride(2) == 1, "rel [T,H,R] bf16");
+  if (kv_offsets) TORCH_CHECK(kv_offsets->scalar_type() == at::kLong, "kv_offsets int64");
+  TORCH_CHECK(part_o.scalar_type() == at::kFloat && part_m.scalar_type() == at::kFloat && part_l.scalar_type() == at::kFloat);
+  auto& qu = c10::xpu::getCurrentXPUStream().queue();
+  const float sc = float(sm_scale * 256.0 * 1.4426950408889634);
+  const float os = float(v_scale * 256.0);
+  const bool i64 = kv_indices.scalar_type() == at::kLong;
+  TORCH_CHECK(i64 || kv_indices.scalar_type() == at::kInt, "kv_indices int32/int64");
+  const int ns = int(nsplit), bm = int(block_m), w = int(sw);
+#define NT(NN)                                                                                       \
+  case NN:                                                                                           \
+    if (i64) by_flags<int64_t, NN>(qu, q, k, v, kv_indptr, kv_indices, kv_offsets, rel, part_o, part_m, \
+                                   part_l, ns, bm, w, sc, os);                                       \
+    else by_flags<int32_t, NN>(qu, q, k, v, kv_indptr, kv_indices, kv_offsets, rel, part_o, part_m,     \
+                               part_l, ns, bm, w, sc, os);                                           \
+    return;
+  switch (n_tokens) {
+    NT(2) NT(3) NT(4) NT(5) NT(6) NT(7) NT(8) NT(9) NT(10)
+  }
+#undef NT
+  TORCH_CHECK(false, "n_tokens must be 2..10");
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("ink_verify_prefix", &ink_verify_prefix); }
