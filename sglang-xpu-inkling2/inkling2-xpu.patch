@@ -0,0 +1,297 @@
+"""Split-KV speculative-verify attention for Inkling on Intel XPU.
+
+Target verify runs N draft tokens per request (DSpark block, topk=1 causal chain).
+The generic path sends them through the prefill extend kernel: one 64-row Q tile
+per (request, head) with N real rows and a serial walk over the whole prefix, i.e.
+24 programs on a 32-core GPU. Here every (request, kv head) program holds all
+N * group query rows (24 for Inkling) in one tile, the prefix is split across
+NSPLIT programs (flash-decode), and a second kernel merges the splits with the
+causal draft-draft block.
+
+Inkling specifics folded in: the relative-position bias
+(``Aux[q_row, head, q_pos - kv_pos]`` for 0 <= d < aux_len, exactly
+``relative_bias_score_mod``), sliding-window rails (``kv_offsets`` = absolute
+position of each rail's first token, window = ``q_pos - kv_pos <= SW``), fp8 KV
+(prefix scores * k_descale, prefix values * v_descale; the draft K/V are the bf16
+inputs), and the natural-log LSE the gated sink consumes.
+"""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+NSPLIT = int(os.environ.get("INK_VERIFY_SPLITS", "32"))
+BLOCK_N = int(os.environ.get("INK_VERIFY_BN", "64"))
+WARPS = int(os.environ.get("INK_VERIFY_WARPS", "4"))
+VERIFY_SYCL = os.environ.get("INK_VERIFY_SYCL", "1") == "1"
+MERGE_ROW = os.environ.get("INK_MERGE_ROW", "1") == "1"
+GRF256 = os.environ.get("INK_VERIFY_GRF256", "1") == "1"  # one program per (req, head, token) row
+
+
+@triton.jit
+def _ink_verify_prefix(
+    Q, K_Buf, V_Buf, Kv_indptr, Kv_indices, Kv_offsets, Aux,
+    Part_O, Part_M, Part_L,
+    sm_scale, k_descale, v_descale,
+    stride_qt, stride_qh, stride_kb, stride_kh, stride_vb, stride_vh,
+    aux_st, aux_sh, aux_len, SW,
+    N: tl.constexpr, G: tl.constexpr, D: tl.constexpr, KVH: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, NSPLIT: tl.constexpr,
+    HAS_OFF: tl.constexpr, HAS_AUX: tl.constexpr, UPCAST: tl.constexpr,
+):
+    b = tl.program_id(0)
+    kh = tl.program_id(1)
+    sp = tl.program_id(2)
+    kv_start = tl.load(Kv_indptr + b)
+    kv_len = tl.load(Kv_indptr + b + 1) - kv_start
+    off = tl.load(Kv_offsets + b).to(tl.int32) if HAS_OFF else 0
+    per = tl.cdiv(kv_len, NSPLIT)
+    lo = sp * per
+    hi = tl.minimum(lo + per, kv_len)
+
+    r = tl.arange(0, BLOCK_M)
+    ti = r // G
+    hg = kh * G + r % G
+    valid_r = r < N * G
+    q_row = b * N + ti
+    q_pos = off + kv_len + ti
+    d = tl.arange(0, D)
+    q = tl.load(Q + q_row[:, None] * stride_qt + hg[:, None] * stride_qh + d[None, :], mask=valid_r[:, None], other=0.0)
+
+    m_i = tl.zeros((BLOCK_M,), tl.float32) - float("inf")
+    l_i = tl.zeros((BLOCK_M,), tl.float32)
+    acc = tl.zeros((BLOCK_M, D), tl.float32)
+    qk_scale = sm_scale * k_descale
+    for n0 in range(lo, hi, BLOCK_N):
+        cols = n0 + tl.arange(0, BLOCK_N)
+        mask_c = cols < hi
+        idx = tl.load(Kv_indices + kv_start + cols, mask=mask_c, other=0)
+        k = tl.load(K_Buf + idx[:, None] * stride_kb + kh * stride_kh + d[None, :], mask=mask_c[:, None], other=0.0)
+        v = tl.load(V_Buf + idx[:, None] * stride_vb + kh * stride_vh + d[None, :], mask=mask_c[:, None], other=0.0)
+        if UPCAST:
+            k = k.to(q.dtype)
+            v = v.to(q.dtype)
+        s = tl.dot(q, tl.trans(k)) * qk_scale
+        dist = q_pos[:, None] - (off + cols)[None, :]
+        if HAS_AUX:
+            bm = valid_r[:, None] & mask_c[None, :] & (dist < aux_len)
+            s += tl.load(Aux + q_row[:, None] * aux_st + hg[:, None] * aux_sh + dist, mask=bm, other=0.0).to(tl.float32)
+        keep = valid_r[:, None] & mask_c[None, :]
+        if SW >= 0:
+            keep = keep & (dist <= SW)
+        s = tl.where(keep, s, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        m_safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+        p = tl.exp(s - m_safe[:, None])
+        alpha = tl.exp(m_i - m_safe)
+        l_i = l_i * alpha + tl.sum(p, 1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(q.dtype), v)
+        m_i = m_new
+
+    base = ((b * KVH + kh) * NSPLIT + sp) * BLOCK_M
+    tl.store(Part_O + (base + r)[:, None] * D + d[None, :], acc * v_descale)
+    tl.store(Part_M + base + r, m_i)
+    tl.store(Part_L + base + r, l_i)
+
+
+@triton.jit
+def _ink_verify_merge(
+    Q, K_Ext, V_Ext, Aux, Part_O, Part_M, Part_L, O, Lse,
+    sm_scale,
+    stride_qt, stride_qh, stride_ket, stride_keh, stride_vet, stride_veh,
+    stride_ot, stride_oh, stride_lt, stride_lh,
+    aux_st, aux_sh, aux_len, SW,
+    N: tl.constexpr, G: tl.constexpr, D: tl.constexpr, KVH: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_E: tl.constexpr, NSPLIT: tl.constexpr,
+    HAS_AUX: tl.constexpr, WRITE_LSE: tl.constexpr, NONCAUSAL: tl.constexpr = False,
+):
+    b = tl.program_id(0)
+    kh = tl.program_id(1)
+    r = tl.arange(0, BLOCK_M)
+    ti = r // G
+    hg = kh * G + r % G
+    valid_r = r < N * G
+    q_row = b * N + ti
+    d = tl.arange(0, D)
+
+    base = (b * KVH + kh) * NSPLIT * BLOCK_M
+    m_tot = tl.zeros((BLOCK_M,), tl.float32) - float("inf")
+    l_tot = tl.zeros((BLOCK_M,), tl.float32)
+    acc = tl.zeros((BLOCK_M, D), tl.float32)
+    for sp in range(NSPLIT):
+        m_s = tl.load(Part_M + base + sp * BLOCK_M + r)
+        m_new = tl.maximum(m_tot, m_s)
+        m_new_s = tl.where(m_new == float("-inf"), 0.0, m_new)
+        a_old = tl.exp(m_tot - m_new_s)
+        a_s = tl.exp(m_s - m_new_s)
+        l_tot = l_tot * a_old + a_s * tl.load(Part_L + base + sp * BLOCK_M + r)
+        acc = acc * a_old[:, None] + a_s[:, None] * tl.load(Part_O + (base + sp * BLOCK_M + r)[:, None] * D + d[None, :])
+        m_tot = m_new
+
+    # causal draft-draft block (bf16 K/V of this verify step)
+    q = tl.load(Q + q_row[:, None] * stride_qt + hg[:, None] * stride_qh + d[None, :], mask=valid_r[:, None], other=0.0)
+    j = tl.arange(0, BLOCK_E)
+    mask_j = j < N
+    ke = tl.load(K_Ext + (b * N + j)[:, None] * stride_ket + kh * stride_keh + d[None, :], mask=mask_j[:, None], other=0.0)
+    ve = tl.load(V_Ext + (b * N + j)[:, None] * stride_vet + kh * stride_veh + d[None, :], mask=mask_j[:, None], other=0.0)
+    s = tl.dot(q, tl.trans(ke.to(q.dtype))) * sm_scale
+    dist = ti[:, None] - j[None, :]
+    if NONCAUSAL:  # bidirectional block (DSpark draft full-attention layers)
+        keep = valid_r[:, None] & mask_j[None, :]
+    else:
+        keep = valid_r[:, None] & mask_j[None, :] & (dist >= 0)
+    if SW >= 0:
+        keep = keep & (dist <= SW)
+    if HAS_AUX:
+        s += tl.load(Aux + q_row[:, None] * aux_st + hg[:, None] * aux_sh + dist, mask=keep & (dist < aux_len), other=0.0).to(tl.float32)
+    s = tl.where(keep, s, float("-inf"))
+    m2 = tl.maximum(m_tot, tl.max(s, 1))  # the diagonal is always kept, so m2 is finite on valid rows
+    m2s = tl.where(m2 == float("-inf"), 0.0, m2)
+    alpha = tl.exp(m_tot - m2s)
+    p = tl.exp(s - m2s[:, None])
+    l2 = l_tot * alpha + tl.sum(p, 1)
+    acc = acc * alpha[:, None] + tl.dot(p.to(q.dtype), ve.to(q.dtype))
+    l_safe = tl.where(l2 == 0.0, 1.0, l2)
+    out = acc / l_safe[:, None]
+    tl.store(O + q_row[:, None] * stride_ot + hg[:, None] * stride_oh + d[None, :], out.to(O.dtype.element_ty), mask=valid_r[:, None])
+    if WRITE_LSE:
+        tl.store(Lse + q_row * stride_lt + hg * stride_lh, m2 + tl.log(l_safe), mask=valid_r)
+
+
+@triton.jit
+def _ink_verify_merge_row(
+    Q, K_Ext, V_Ext, Aux, Part_O, Part_M, Part_L, O, Lse,
+    sm_scale,
+    stride_qt, stride_qh, stride_ket, stride_keh, stride_vet, stride_veh,
+    stride_ot, stride_oh, stride_lt, stride_lh,
+    aux_st, aux_sh, aux_len, SW,
+    N: tl.constexpr, G: tl.constexpr, D: tl.constexpr, KVH: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_E: tl.constexpr, NSPLIT: tl.constexpr,
+    HAS_AUX: tl.constexpr, WRITE_LSE: tl.constexpr, NONCAUSAL: tl.constexpr,
+):
+    # same math as _ink_verify_merge for ONE query row: all splits in one [NSPLIT, D] load, the draft
+    # block as elementwise dots (N <= 16); grid (bs, H, N) instead of (bs, KVH)
+    b = tl.program_id(0)
+    h = tl.program_id(1)
+    t = tl.program_id(2)
+    kh = h // G
+    r = t * G + h % G
+    sp = tl.arange(0, NSPLIT)
+    d = tl.arange(0, D)
+    idx = (b * KVH + kh) * NSPLIT * BLOCK_M + sp * BLOCK_M + r
+    m_s = tl.load(Part_M + idx)
+    l_s = tl.load(Part_L + idx)
+    q_row = b * N + t
+    q = tl.load(Q + q_row * stride_qt + h * stride_qh + d).to(tl.float32)
+    j = tl.arange(0, BLOCK_E)
+    mask_j = j < N
+    ke = tl.load(K_Ext + (b * N + j)[:, None] * stride_ket + kh * stride_keh + d[None, :], mask=mask_j[:, None], other=0.0)
+    s = tl.sum(ke.to(tl.float32) * q[None, :], 1) * sm_scale
+    dist = t - j
+    if NONCAUSAL:
+        keep = mask_j
+    else:
+        keep = mask_j & (dist >= 0)
+    if SW >= 0:
+        keep = keep & (dist <= SW)
+    if HAS_AUX:
+        s += tl.load(Aux + q_row * aux_st + h * aux_sh + dist, mask=keep & (dist >= 0) & (dist < aux_len), other=0.0).to(tl.float32)
+    s = tl.where(keep, s, float("-inf"))
+    m2 = tl.maximum(tl.max(m_s, 0), tl.max(s, 0))  # the diagonal is always kept: finite
+    w = tl.exp(m_s - m2)
+    p = tl.exp(s - m2)
+    l = tl.sum(w * l_s, 0) + tl.sum(p, 0)
+    acc = tl.sum(tl.load(Part_O + idx[:, None] * D + d[None, :]) * w[:, None], 0)
+    ve = tl.load(V_Ext + (b * N + j)[:, None] * stride_vet + kh * stride_veh + d[None, :], mask=mask_j[:, None], other=0.0)
+    acc += tl.sum(ve.to(tl.float32) * p[:, None], 0)
+    tl.store(O + q_row * stride_ot + h * stride_oh + d, (acc / l).to(O.dtype.element_ty))
+    if WRITE_LSE:
+        tl.store(Lse + q_row * stride_lt + h * stride_lh, m2 + tl.log(l))
+
+
+_bufs = {}
+
+
+def _parts(device, bs, kvh, block_m, d):
+    key = (device, kvh, block_m, d, NSPLIT)
+    cur = _bufs.get(key)
+    need = bs * kvh * NSPLIT * block_m
+    if cur is None or cur[1].numel() < need:
+        # Sized once for the largest batch seen; graph capture runs the largest bs first.
+        n = max(need, 4 * kvh * NSPLIT * block_m)
+        cur = (torch.empty(n * d, device=device, dtype=torch.float32),
+               torch.empty(n, device=device, dtype=torch.float32),
+               torch.empty(n, device=device, dtype=torch.float32))
+        _bufs[key] = cur
+    return cur
+
+
+def ink_verify_attention(q, k_ext, v_ext, o, k_buf, v_buf, kv_indptr, kv_indices, kv_offsets,
+                         aux, lse, *, num_tokens_per_req, sm_scale, k_descale=1.0, v_descale=1.0,
+                         sliding_window_size=-1, causal=True):
+    """q/o: [bs*N, H, D]; k_ext/v_ext: [bs*N, KVH, D] (this step's draft K/V); k_buf/v_buf: the
+    cache [slots, KVH, D]; kv_indptr/kv_indices: per-request prefix list (or window rail, then
+    kv_offsets = absolute position of its first token); aux: rel bias [bs*N, H, EXT] or None;
+    lse: [bs*N, H] fp32 or None."""
+    N = int(num_tokens_per_req)
+    T, H, D = q.shape
+    bs = T // N
+    KVH = k_buf.shape[1]
+    G = H // KVH
+    BLOCK_M = max(16, triton.next_power_of_2(N * G))
+    BLOCK_E = max(16, triton.next_power_of_2(N))
+    po, pm, pl = _parts(q.device, bs, KVH, BLOCK_M, D)
+    has_aux = aux is not None
+    aux_t = aux if has_aux else q
+    a_st, a_sh, a_len = (aux.stride(0), aux.stride(1), aux.shape[2]) if has_aux else (0, 0, 0)
+    sw = -1 if sliding_window_size is None else int(sliding_window_size)
+    has_off = kv_offsets is not None
+    if (VERIFY_SYCL and q.device.type == "xpu" and k_buf.element_size() == 1 and D == 128 and G == 3
+            and 2 <= N <= 10 and q.dtype == torch.bfloat16 and q.stride(-1) == 1
+            and (aux is None or (aux.dtype == torch.bfloat16 and aux.stride(-1) == 1))):
+        # SYCL prefix (xpu_sycl/ink_verify.sycl): one sub-group per draft token over shared key chunks
+        from sglang.kernels.ops.attention.xpu_sycl import load_ext
+
+        off = None
+        if has_off:
+            off = kv_offsets if kv_offsets.dtype == torch.int64 else kv_offsets.to(torch.int64)
+        # 256-GRF build at bs 1 (global 8k prefix 192 -> 143 us); the default build is faster at bs 4.
+        # Both load together on the first call (the same point the single build used to load).
+        ext_def = load_ext("ink_verify", fast_math=False)
+        ext = load_ext("ink_verify", fast_math=False, defs=("INK_GRF256",)) if GRF256 else ext_def
+        (ext if bs == 1 else ext_def).ink_verify_prefix(
+            q, k_buf, v_buf, kv_indptr, kv_indices, off, aux, po, pm, pl, N, NSPLIT, BLOCK_M, sw,
+            float(sm_scale) * float(k_descale), float(v_descale),
+        )
+    else:
+        _ink_verify_prefix[(bs, KVH, NSPLIT)](
+            q, k_buf, v_buf, kv_indptr, kv_indices, kv_offsets if has_off else kv_indptr, aux_t,
+            po, pm, pl, float(sm_scale), float(k_descale), float(v_descale),
+            q.stride(0), q.stride(1), k_buf.stride(0), k_buf.stride(1), v_buf.stride(0), v_buf.stride(1),
+            a_st, a_sh, a_len, sw,
+            N=N, G=G, D=D, KVH=KVH, BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, NSPLIT=NSPLIT,
+            HAS_OFF=has_off, HAS_AUX=has_aux, UPCAST=k_buf.dtype != q.dtype, num_warps=WARPS,
+        )
+    write_lse = lse is not None
+    lse_t = lse if write_lse else pm
+    if MERGE_ROW:
+        _ink_verify_merge_row[(bs, H, N)](
+            q, k_ext, v_ext, aux_t, po, pm, pl, o, lse_t, float(sm_scale),
+            q.stride(0), q.stride(1), k_ext.stride(0), k_ext.stride(1), v_ext.stride(0), v_ext.stride(1),
+            o.stride(0), o.stride(1), lse_t.stride(0) if write_lse else 0, lse_t.stride(1) if write_lse else 0,
+            a_st, a_sh, a_len, sw,
+            N=N, G=G, D=D, KVH=KVH, BLOCK_M=BLOCK_M, BLOCK_E=triton.next_power_of_2(N), NSPLIT=NSPLIT,
+            HAS_AUX=has_aux, WRITE_LSE=write_lse, NONCAUSAL=not causal, num_warps=2,
+        )
+        return o
+    _ink_verify_merge[(bs, KVH)](
+        q, k_ext, v_ext, aux_t, po, pm, pl, o, lse_t, float(sm_scale),
+        q.stride(0), q.stride(1), k_ext.stride(0), k_ext.stride(1), v_ext.stride(0), v_ext.stride(1),
+        o.stride(0), o.stride(1), lse_t.stride(0) if write_lse else 0, lse_t.stride(1) if write_lse else 0,
+        a_st, a_sh, a_len, sw,
+        N=N, G=G, D=D, KVH=KVH, BLOCK_M=BLOCK_M, BLOCK_E=BLOCK_E, NSPLIT=NSPLIT,
+        HAS_AUX=has_aux, WRITE_LSE=write_lse, NONCAUSAL=not causal, num_warps=WARPS,
+    )
+    return o
