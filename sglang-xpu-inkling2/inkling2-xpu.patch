+# --------------------------------------------------------------------------- loop message controllers
+
+
+@triton.jit
+def _ctrl_down_bp(Normed, Down, Partials, T, KSPLIT: tl.constexpr, R: tl.constexpr, K: tl.constexpr,
+                  BR: tl.constexpr, CH: tl.constexpr, BM: tl.constexpr):
+    """partials[m, ks, t, r] = normed[m, t, ks*CH:(ks+1)*CH] . down[m, r, same]: the down
+    tile is a natural (R, K) row-major 2D block; decode rows ride the padded M of the dot."""
+    pid = tl.program_id(0)
+    m = pid // KSPLIT
+    ks = pid % KSPLIT
+    r0 = tl.program_id(1) * BR
+    rows = tl.arange(0, BM)
+    k = ks * CH + tl.arange(0, CH)
+    x = tl.load(Normed + (m * T + rows[:, None]).to(tl.int64) * K + k[None, :], rows[:, None] < T, other=0)
+    w_ptr = tl.make_block_ptr(Down + m.to(tl.int64) * R * K, (R, K), (K, 1), (r0, ks * CH), (BR, CH), (1, 0))
+    acc = tl.dot(tl.load(w_ptr), tl.trans(x))  # (BR, BM)
+    r = r0 + tl.arange(0, BR)
+    out = Partials + ((pid * T + rows[None, :]).to(tl.int64) * R + r[:, None])
+    tl.store(out, acc, rows[None, :] < T)
+
+
+@triton.jit
+def _ctrl_mix_bp(Partials, Gain, Forget, Dest, Message, Out, T, DEST_STRIDE, MESSAGE_STRIDE,
+                 W: tl.constexpr, R: tl.constexpr, KSPLIT: tl.constexpr, BN: tl.constexpr, BM: tl.constexpr):
+    """out[m, t, n] = (1 - tanh(h . forget[m, n])) * dest + tanh(h . gain[m, n]) * message,
+    h = bf16(sum_ks partials[m, ks, t]) in split order."""
+    n0 = tl.program_id(0) * BN
+    m = tl.program_id(1).to(tl.int64)
+    rows = tl.arange(0, BM)
+    rank = tl.arange(0, R)
+    row_ok = rows[:, None] < T
+    p = Partials + (m * KSPLIT * T + rows[:, None]) * R + rank[None, :]
+    hidden = tl.load(p, row_ok, other=0)
+    for ks in tl.static_range(1, KSPLIT):
+        hidden = hidden + tl.load(p + ks * T * R, row_ok, other=0)
+    ht = tl.trans(hidden.to(tl.bfloat16))  # (R, BM)
+    g_ptr = tl.make_block_ptr(Gain + m * W * R, (W, R), (R, 1), (n0, 0), (BN, R), (1, 0))
+    f_ptr = tl.make_block_ptr(Forget + m * W * R, (W, R), (R, 1), (n0, 0), (BN, R), (1, 0))
+    gain = tl.dot(tl.load(g_ptr), ht)  # (BN, BM)
+    forget = tl.dot(tl.load(f_ptr), ht)
+    cols = n0 + tl.arange(0, BN)
+    offs = rows[None, :].to(tl.int64) * W + cols[:, None]
+    mask = rows[None, :] < T
+    dest = tl.load(Dest + m * DEST_STRIDE + offs, mask, other=0)
+    message = tl.load(Message + m * MESSAGE_STRIDE + offs, mask, other=0)
+    out = (1.0 - libdevice.tanh(forget)) * dest + libdevice.tanh(gain) * message
+    tl.store(Out + m * T * W + offs, out, mask)
+
+
+CTRL_CH, CTRL_BR, CTRL_BN = 128, 64, 32  # B70 sweep: 17 us vs 50 us (num=3, T=1)
+
+
+def message_controllers_decode(dest, dest_stride, message, message_stride, down, gain, forget, eps,
+                               ch=None, br=None, bn=None):
+    """XPU decode path (tokens <= 16) of inkling2_loop.message_controllers."""
+    from sglang.kernels.ops.elementwise.inkling2_loop import _controller_norm
+
+    num, rank, k = down.shape
+    tokens, width = dest.shape[-2], dest.shape[-1]
+    if "ctrl" in INK_SKIP:
+        return torch.zeros((num, tokens, width), dtype=torch.float32, device=dest.device)
+    ch, br, bn = ch or CTRL_CH, br or CTRL_BR, bn or CTRL_BN
+    assert k % ch == 0 and rank % br == 0 and width % bn == 0 and tokens <= 16
+    out = torch.empty((num, tokens, width), dtype=torch.float32, device=dest.device)
+    normed = torch.empty((num, tokens, k), dtype=torch.bfloat16, device=dest.device)
+    _controller_norm[(tokens, num)](
+        dest, message, normed, tokens, dest_stride, message_stride, eps, width,
+        triton.next_power_of_2(width), False, num_warps=8, enable_fp_fusion=False,
+    )
+    ksplit = k // ch
+    partials = torch.empty((num, ksplit, tokens, rank), dtype=torch.float32, device=dest.device)
+    _ctrl_down_bp[(num * ksplit, rank // br)](normed, down, partials, tokens, ksplit, rank, k, br, ch, 16, num_warps=4)
+    _ctrl_mix_bp[(width // bn, num)](
+        partials, gain, forget, dest, message, out, tokens, dest_stride, message_stride,
+        width, rank, ksplit, bn, 16, num_warps=4,
+    )
+    return out
