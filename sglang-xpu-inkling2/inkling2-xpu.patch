+def _sycl_gemv_cfg(fp4, a_div, rows):
+    """(vb, r, nsg) for the SYCL GEMV where it beat the Triton bp16 kernel on B70 (L2-cold,
+    16 expert sets): NVFP4 w13 53 -> 46 us (8 rows), MXFP8 w13 93 -> 73 us, MXFP8 w2 44 -> 37 us.
+    NVFP4 w2 (K=1152) stays on Triton (SYCL 40 vs 37.5 us)."""
+    if not _SYCL_GEMV:
+        return None
+    if fp4:
+        return ((8, 2, 8) if rows <= 8 else (8, 4, 4)) if a_div > 1 else None
+    return ((16, 2, 8) if rows <= 8 else (16, 4, 8)) if a_div > 1 else (8, 4, 8)
+
+
+def routed_gemv(a, weight, scale, flat_ids, a_div, *, out_dtype=torch.bfloat16, bn=None, bk=None, warps=None, impl=None):
+    fp4 = weight.dtype == torch.uint8
+    experts, n, k_stored = weight.shape
+    k = k_stored * 2 if fp4 else k_stored
+    rows = flat_ids.numel()
+    out = torch.empty((rows, n), dtype=out_dtype, device=a.device)
+    if not rows:
+        return out
+    w = weight if fp4 else weight.view(torch.uint8)
+    s = scale.view(torch.uint8)
+    impl = impl or GEMV_IMPL
+    if (GGEMV and fp4 and a_div > 1 and rows >= GGEMV_MIN_ROWS and not (bn or bk or warps)
+            and a.dtype == torch.bfloat16 and out_dtype == torch.bfloat16 and a.stride(-1) == 1):
+        # spec-verify sized batches: decode each NVFP4 w13 tile once per distinct expert and apply it to
+        # all of that expert's rows (B70, T=8 / 64 rows: 316 -> 246 us, 534 GB/s of distinct bytes)
+        from sglang.kernels.ops.attention.xpu_sycl import ink_ggemv_ext
+
+        ext = ink_ggemv_ext()
+        table = torch.empty(1 + 4 * rows, dtype=torch.int32, device=a.device)
+        ext.ink_group(flat_ids, table, experts)
+        ext.ink_ggemv(a, w, s, out, table, rows, True, k, a_div, 8, 4, 4, 4)
+        return out
+    if (GGEMV_W2 and fp4 and a_div == 1 and rows >= GGEMV_MIN_ROWS and not (bn or bk or warps)
+            and a.dtype == torch.bfloat16 and out_dtype == torch.bfloat16 and a.stride(-1) == 1 and k // 2 >= 128):
+        # w2 (one activation row per routed row): grouped by expert too; 576-byte rows take a partial last
+        # K window. B70 T=8 sweep 8:4:8:4 ~1.1x the Triton per-row kernel (noisy, L2-cold sets)
+        from sglang.kernels.ops.attention.xpu_sycl import ink_ggemv_ext
+
+        ext = ink_ggemv_ext()
+        table = torch.empty(1 + 4 * rows, dtype=torch.int32, device=a.device)
+        ext.ink_group(flat_ids, table, experts)
+        ext.ink_ggemv(a, w, s, out, table, rows, True, k, 1, 8, 4, 8, 4)
+        return out
+    cfg = _sycl_gemv_cfg(fp4, a_div, rows) if impl == "bp16" and not (bn or bk or warps) else None
+    if cfg is not None and a.dtype == torch.bfloat16 and out_dtype == torch.bfloat16 and a.stride(-1) == 1:
+        from sglang.kernels.ops.attention.xpu_sycl import ink_gemv_ext
+
+        ink_gemv_ext().ink_gemv(a, w, s, out, flat_ids, fp4, k, a_div, *cfg)
+        return out
+    if impl == "bp16" and not (bn or bk or warps):
+        # B70 sweeps (L2-cold, 16 expert sets): NVFP4 w13 16/128/4 53 us (447 GB/s),
+        # w2 32/64/4 34 us; old pointer-gather kernel 110 / 55 us.
+        # MXFP8 w13 16/256/4 81 us (539 GB/s), w2 32/64/4 49 us; old 118 / 62 us.
+        # w2 (a_div 1), L2-cold sweep 2026-11-22: NVFP4 32/32/2 28.8 us (was 32/64/4 ~34),
+        # MXFP8 32/128/8 28.4 us
+        bn, bk, warps = ((16, 128, 4) if fp4 else (16, 256, 4)) if a_div > 1 else ((32, 32, 2) if fp4 else (32, 128, 8))
+    bn = bn or GEMV_BN
+    bk = bk or GEMV_BK
+    assert k % bk == 0 and bk % 32 == 0, (k, bk)  # the K loop is unmasked
+    if impl == "dot" and fp4:
+        assert n % bn == 0 and bk <= 256, (n, bn, bk)
+        _routed_gemv_dot[(rows, n // bn)](
+            a, w, s, out, flat_ids, experts, n, k,
+            a.stride(0), out.stride(0), w.stride(0), w.stride(1), s.stride(0), s.stride(1),
+            a_div, bn, bk, num_warps=warps or 4,
+        )
+        return out
+    if impl == "bp16" and GROUPED_GEMV and rows >= GROUPED_MIN_ROWS and rows <= 64:
+        sorted_ids, order = torch.sort(flat_ids, stable=True)
+        _grouped_gemv_bp[(rows, triton.cdiv(n, bn))](
+            a, w, s, out, sorted_ids, order.to(torch.int32), rows, experts, n, k,
+            a.stride(0), out.stride(0), w.stride(0), w.stride(1), s.stride(0), s.stride(1),
+            a_div, fp4, bn, bk, 8,
+            num_warps=warps or (8 if fp4 else GEMV_WARPS),
+        )
+        return out
+    kernel = _routed_gemv_bp if impl in ("bp", "bp16", "dot") else _routed_gemv
+    extra = {}
+    if kernel is _routed_gemv_bp:
+        assert n % bn == 0, (n, bn)  # block loads are unchecked
+        extra["F16_DECODE"] = impl == "bp16"
+    kernel[(rows, triton.cdiv(n, bn))](
+        a, w, s, out, flat_ids, experts, n, k,
+        a.stride(0), out.stride(0), w.stride(0), w.stride(1), s.stride(0), s.stride(1),
+        a_div, fp4, bn, bk,
+        num_warps=warps or (8 if fp4 else GEMV_WARPS), **extra,
+    )
+    return out
+
+
+def align_rows(flat_ids, num_experts, block_m):
+    """Rows (token * top_k + k) grouped by expert into block_m-row blocks, with fixed
+    shapes (CUDA-graph safe): sorted_rows (pad = rows), block_expert, num_blocks."""
+    rows = flat_ids.numel()
+    device = flat_ids.device
+    max_blocks = triton.cdiv(rows, block_m) + min(num_experts, rows)
+    ids = flat_ids.to(torch.int64)
+    sorted_ids, order = torch.sort(ids, stable=True)
+    counts = torch.zeros(num_experts, dtype=torch.int64, device=device)
+    counts.scatter_add_(0, ids, torch.ones_like(ids))
+    blocks = (counts + block_m - 1) // block_m
+    block_end = torch.cumsum(blocks, 0)
+    block_start = block_end - blocks
+    row_start = torch.cumsum(counts, 0) - counts
+    rank = torch.arange(rows, device=device) - row_start[sorted_ids]
+    dest = block_start[sorted_ids] * block_m + rank
+    sorted_rows = torch.full((max_blocks * block_m,), rows, dtype=torch.int32, device=device)
+    sorted_rows.scatter_(0, dest, order.to(torch.int32))
+    block_expert = torch.searchsorted(
+        block_end, torch.arange(max_blocks, device=device), right=True
+    ).clamp_(max=num_experts - 1).to(torch.int32)
+    return sorted_rows, block_expert, block_end[-1:].to(torch.int32), max_blocks
+
+
+def grouped_matmul(a, weight, scale, routing, rows, a_div, *, out_dtype=torch.bfloat16, block_m=None, bn=64, bk=64, warps=4, **opts):
+    """out[r] = a[r // a_div] @ dequant(weight[expert of r]).T for the routed rows r."""
+    sorted_rows, block_expert, num_blocks, max_blocks = routing
+    fp4 = weight.dtype == torch.uint8
+    experts, n, k_stored = weight.shape
+    k = k_stored * 2 if fp4 else k_stored
+    out = torch.empty((rows, n), dtype=out_dtype, device=a.device)
+    if not rows:
+        return out
+    w = weight if fp4 else weight.view(torch.uint8)
+    s = scale.view(torch.uint8)
+    _grouped_dequant_gemm[(max_blocks, triton.cdiv(n, bn))](
+        a,
+        w,
+        s,
+        out,
+        sorted_rows,
+        block_expert,
+        num_blocks,
+        rows,
+        n,
+        k,
+        a.stride(0),
+        out.stride(0),
+        w.stride(0),
+        w.stride(1),
+        s.stride(0),
+        s.stride(1),
+        a_div,
+        fp4,
+        block_m or BLOCK_M,
+        bn,
+        bk,
+        E_LOCAL=experts,
+        num_warps=warps,
+        **opts,
+    )
+    return out
+
+
+BLOCK_M = 16
+# prefill: dequant-to-bf16 scratch + block-pointer bf16 GEMM wins from ~1k tokens (B70)
+SCRATCH_MIN_ROWS = 8192
+
+
+_identity = None
+
+
+def routed_experts(experts, x, weights, ids, combine=True):
+    """Inkling2Experts.forward for a single EP rank without the CUDA kernels: the
+    Hopper (Marlin) recipe with dequantizing Triton grouped GEMMs."""
+    from sglang.kernels.ops.gemm import inkling2_marlin_sm90 as marlin_sm90
+    from sglang.kernels.ops.moe import inkling2_experts_sm90 as experts_sm90
+    from sglang.srt.models.inkling_common.inkling2_moe import RoutedOutput
+
+    tokens, top_k = ids.shape
+    num_local = experts.w13_weight.shape[0]
+    # EP (ep_size > 1): this rank owns experts [start, start + num_local). Hidden states are
+    # replicated, so each rank runs only its own rows and an all-reduce sums the partials
+    # (no all-to-all). Non-local rows: GEMV kernels exit early (local id out of range), the
+    # grouped/scratch GEMMs skip a sentinel bucket, the swiglu/source_partial helpers skip them.
+    ep = experts.ep_size
+    start = experts.ep_rank * num_local if ep > 1 else 0
+    if _ROUTE_STATS and tokens == 8:
+        _route_stats.append(ids.unique().numel())
+        if len(_route_stats) % 480 == 0:
+            print(f"[ink-route] T=8 distinct experts mean {sum(_route_stats[-480:]) / 480:.1f} (rows 64)", flush=True)
+    flat = ids.flatten().to(torch.int32)
+    rows = flat.numel()
+    nvfp4 = experts.w13_weight.dtype == torch.uint8
+    gemv = rows <= GEMV_MAX_ROWS
+    scratch = rows >= SCRATCH_MIN_ROWS
+    local = flat - start if ep > 1 else flat
+    if ep > 1 and not gemv:
+        local = torch.where((local >= 0) & (local < num_local), local, num_local)
+    routing = None if gemv else align_rows(local, num_local + (ep > 1), 128 if scratch else BLOCK_M)
+
+    def matmul(a, weight, scale, a_div):
+        if gemv and "gemv" in INK_SKIP:
+            return torch.zeros((rows, weight.shape[1]), dtype=torch.bfloat16, device=a.device)
+        if gemv:
+            return routed_gemv(a, weight, scale, local, a_div)
+        if scratch:
+            return scratch_matmul(a, weight, scale, routing, rows, a_div)
+        return grouped_matmul(a, weight, scale, routing, rows, a_div)
+
+    caps = (experts.gate_cap, experts.up_cap)
+    if nvfp4:
+        xq, x_amax = experts_sm90.fake_quantize(x.contiguous())
+    else:
+        xq = experts_sm90.fake_quantize_mxfp8(x.contiguous())
+    acc = matmul(xq, experts.w13_weight, experts.w13_scale, top_k)
+    if nvfp4:
+        hidden, hidden_amax = marlin_sm90.swiglu_fake_quantize(
+            acc,
+            flat,
+            weights.flatten().float(),
+            (x_amax, experts.w13_amax, experts.w13_outer_scale_denominator),
+            start,
+            num_local,
+            top_k,
+            caps,
+        )
+        scales = (hidden_amax, experts.w2_amax, experts.w2_outer_scale_denominator)
+    else:
+        hidden = marlin_sm90.swiglu_fake_quantize_mxfp8(
+            acc, flat, weights.flatten().float(), start, num_local, caps
+        )
+        scales = (None, None, None)
+    down = matmul(hidden, experts.w2_weight, experts.w2_scale, 1)
+    combined = marlin_sm90.source_partial(down, flat, scales, start, num_local, top_k)
+    if ep > 1:
+        # fp32 partials: the sum matches the single-rank fp32 combine up to add order
+        from sglang.srt.runtime_context import get_parallel
+
+        combined = get_parallel().moe_ep_group.all_reduce(combined)
+    if not combine:
+        global _identity
+        if _identity is None or _identity.device != x.device or _identity.numel() < tokens:
+            if torch.xpu.is_current_stream_capturing():  # never allocate the shared buffer in a graph pool
+                return RoutedOutput(combined, torch.arange(tokens, dtype=torch.int32, device=x.device), 1)
+            _identity = torch.arange(max(tokens, 4096), dtype=torch.int32, device=x.device)
+        return RoutedOutput(combined, _identity[:tokens], 1)
+    return combined.to(x.dtype)
+
