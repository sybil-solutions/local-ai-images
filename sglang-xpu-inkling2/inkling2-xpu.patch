diff --git a/python/sglang/srt/distributed/device_communicators/xpu_p2p_ar.py b/python/sglang/srt/distributed/device_communicators/xpu_p2p_ar.py
new file mode 100644
index 00000000..0e1a8cce
--- /dev/null
+++ b/python/sglang/srt/distributed/device_communicators/xpu_p2p_ar.py
@@ -0,0 +1,113 @@
+"""One-shot peer-to-peer all-reduce for 2 Intel XPUs over PCIe (torch symmetric memory + Triton).
+
+oneCCL's floor on 2x Arc Pro B70 (PCIe Gen4 x16 each, through the root complex) is ~55 us per
+all-reduce at decode sizes; Inkling decode issues ~96 of them per step (attention + MoE sums over
+48 loop visits), ~5 ms of a 20 ms step. This kernel pushes each rank's rows straight into the peer's
+inbox (double-buffered by epoch parity), release-stores a per-program flag on the peer at system
+scope, spins on its own flag, then adds: 5.6 us (1 token) / 7.7 us (4 tokens) / 25 us (32 tokens)
+inside an XPU graph, results identical to oneCCL (one fp32 add of two values, rounded once).
+Inside graphs oneCCL itself is 8.5-12 us (the ~55 us is eager host overhead), so the end-to-end
+gain is small: TP2 decode +2-3% (8k C1 49.5 -> 51.2, 32k C1 41.8 -> 43.0 tok/s).
+
+Constraints: world size 2; every rank must issue the same sequence of eligible calls (true for the
+SPMD model forward; per-program epoch counters live on device, so XPU graph replays stay in sync);
+needs Level Zero IPC (the container needs CAP_SYS_PTRACE for pidfd_getfd), else it stays disabled.
+Only small (decode) messages use it: a spinning program waits for the peer, and the xe driver kills
+jobs running > 5 s, so large / eager prefill reductions stay on oneCCL.
+"""
+
+import logging
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+logger = logging.getLogger(__name__)
+
+_MAX_ELEMS = 1 << 18  # inbox slot: 256K elements (1 MiB fp32)
+# Use it only where it beats oneCCL inside graphs (measured, 2x B70): 1 tok 5.7 vs 12.1 us,
+# 4 tok 7.7 vs 8.9 us, but 32 tok 25.3 vs 13.7 us (one PCIe round trip per 16K-element program).
+_USE_MAX_ELEMS = int(os.environ.get("SGLANG_XPU_P2P_AR_MAX_ELEMS", "16384"))
+_BLOCK = int(os.environ.get("SGLANG_XPU_P2P_AR_BLOCK", "16384"))
+_WARPS = int(os.environ.get("SGLANG_XPU_P2P_AR_WARPS", "32"))
+_MAX_PROGRAMS = 4096
+
+
+@triton.jit
+def _p2p_ar_kernel(X, Out, PeerInbox, MyInbox, PeerFlag, MyFlag, Epoch, N, SLOT, BLOCK: tl.constexpr):
+    pid = tl.program_id(0)
+    offs = pid * BLOCK + tl.arange(0, BLOCK)
+    m = offs < N
+    e = tl.load(Epoch + pid) + 1
+    tl.store(Epoch + pid, e)
+    slot = (e % 2) * SLOT
+    x = tl.load(X + offs, mask=m, other=0.0)
+    tl.store(PeerInbox + slot + offs, x.to(tl.float32), mask=m)
+    tl.atomic_xchg(PeerFlag + pid, e, sem="release", scope="sys")
+    while tl.atomic_add(MyFlag + pid, 0, sem="acquire", scope="sys") < e:
+        pass
+    y = tl.load(MyInbox + slot + offs, mask=m, other=0.0, volatile=True)
+    tl.store(Out + offs, (x.to(tl.float32) + y).to(Out.dtype.element_ty), mask=m)
+
+
+def _capturing() -> bool:
+    if os.environ.get("SGLANG_XPU_P2P_AR_EAGER", "0") == "1":
+        return True
+    f = getattr(torch.xpu, "is_current_stream_capturing", None)
+    return bool(f()) if f is not None else False
+
+
+class XpuP2PAllReduce:
+    def __init__(self, group: "torch.distributed.ProcessGroup", device: torch.device):
+        self.disabled = True
+        if os.environ.get("SGLANG_XPU_P2P_AR", "0") != "1":  # opt-in: hung TP2 8k C4 (tp2s) with the fast decode
+            return
+        import torch.distributed as dist
+        import torch.distributed._symmetric_memory as symm
+
+        world = dist.get_world_size(group)
+        if world != 2:
+            return
+        rank = dist.get_rank(group)
+        peer = 1 - rank
+        try:
+            name = group.group_name
+            self.inbox = symm.empty(2 * _MAX_ELEMS, device=device, dtype=torch.float32)
+            self.flags = symm.empty(_MAX_PROGRAMS, device=device, dtype=torch.int32)
+            self.flags.zero_()
+            hi = symm.rendezvous(self.inbox, name)
+            hf = symm.rendezvous(self.flags, name)
+            self.peer_inbox = hi.get_buffer(peer, (2 * _MAX_ELEMS,), torch.float32)
+            self.peer_flags = hf.get_buffer(peer, (_MAX_PROGRAMS,), torch.int32)
+            self.epoch = torch.zeros(_MAX_PROGRAMS, dtype=torch.int32, device=device)
+            self._handles = (hi, hf)
+            torch.xpu.synchronize(device)
+            dist.barrier(group=group)
+        except Exception as e:  # no L0 IPC (e.g. container without CAP_SYS_PTRACE)
+            logger.warning("XPU P2P all-reduce disabled: %s", e)
+            return
+        self.disabled = False
+        logger.info("XPU P2P all-reduce enabled (rank %d, <= %d elements)", rank, _MAX_ELEMS)
+
+    def eligible(self, x: torch.Tensor) -> bool:
+        # Only inside XPU graph capture (decode graphs): ranks replay in lockstep there. In eager
+        # mode one rank can trail by seconds (Triton JIT), and a GPU-side spin that long gets the
+        # job killed by the xe driver (5 s), so eager reductions stay on oneCCL (host-side wait).
+        return (
+            not self.disabled
+            and _capturing()
+            and x.is_contiguous()
+            and x.numel() <= min(_MAX_ELEMS, _USE_MAX_ELEMS)
+            and x.dtype in (torch.bfloat16, torch.float16, torch.float32)
+        )
