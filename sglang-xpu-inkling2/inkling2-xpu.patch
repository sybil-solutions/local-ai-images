+"""SYCL kernels for Intel XPU, JIT-built once with torch.utils.cpp_extension (icpx)."""
+import os
+
+_mod = None
+
+
+def ink_decode_ext():
+    global _mod
+    if _mod is None:
+        from torch.utils.cpp_extension import load
+
+        here = os.path.dirname(__file__)
+        os.environ.setdefault("TORCH_XPU_ARCH_LIST", "bmg")
+        _mod = load(
+            name="ink_decode_xpu",
+            sources=[os.path.join(here, "ink_decode.sycl")],
+            extra_cflags=["-O3"],
+            extra_sycl_cflags=["-O3", "-ffast-math"],
+            verbose=os.environ.get("SGLANG_XPU_SYCL_VERBOSE") == "1",
+        )
+    return _mod
+
+
+_gemv = None
+
+
+def ink_gemv_ext():
+    global _gemv
+    if _gemv is None:
+        from torch.utils.cpp_extension import load
+
+        here = os.path.dirname(__file__)
+        os.environ.setdefault("TORCH_XPU_ARCH_LIST", "bmg")
+        _gemv = load(
+            name="ink_gemv_xpu",
+            sources=[os.path.join(here, "ink_gemv.sycl")],
+            extra_cflags=["-O3"],
+            extra_sycl_cflags=["-O3", "-ffast-math"],
+            verbose=os.environ.get("SGLANG_XPU_SYCL_VERBOSE") == "1",
+        )
+    return _gemv
+
+
+_dense = None
+
+
+def ink_dense_ext():
+    global _dense
+    if _dense is None:
+        from torch.utils.cpp_extension import load
+
+        here = os.path.dirname(__file__)
+        os.environ.setdefault("TORCH_XPU_ARCH_LIST", "bmg")
+        _dense = load(
+            name="ink_dense_xpu",
+            sources=[os.path.join(here, "ink_dense.sycl")],
+            extra_cflags=["-O3"],
+            extra_sycl_cflags=["-O3", "-ffast-math"],
+            verbose=os.environ.get("SGLANG_XPU_SYCL_VERBOSE") == "1",
+        )
+    return _dense
+
+
+_ggemv = None
+
+
+def ink_ggemv_ext():
+    global _ggemv
+    if _ggemv is None:
+        from torch.utils.cpp_extension import load
+
+        here = os.path.dirname(__file__)
+        os.environ.setdefault("TORCH_XPU_ARCH_LIST", "bmg")
+        _ggemv = load(
+            name="ink_ggemv_xpu",
+            sources=[os.path.join(here, "ink_ggemv.sycl")],
+            extra_cflags=["-O3"],
+            extra_sycl_cflags=["-O3", "-ffast-math"],
+            verbose=os.environ.get("SGLANG_XPU_SYCL_VERBOSE") == "1",
+        )
+    return _ggemv
+
+
+_exts = {}
+
+
+def load_ext(name, fast_math=True, defs=()):
+    """xpu_sycl/<name>.sycl as module ink_<name>_xpu (JIT-built once, cached). fast_math=False for kernels
+    that rely on IEEE infinities (-ffast-math implies finite-math: inf compares fold away)."""
+    defs = tuple(defs) + tuple(d for d in os.environ.get(f"INK_{name.upper()}_DEFS", "").split(",") if d)
+    mod = _exts.get((name, defs))
+    if mod is None:
+        from torch.utils.cpp_extension import load
+
+        here = os.path.dirname(__file__)
+        os.environ.setdefault("TORCH_XPU_ARCH_LIST", "bmg")
+        # defs / INK_<NAME>_DEFS=A,B: -DA -DB (kernel variants, e.g. INK_GRF256)
+        mod = _exts[(name, defs)] = load(
+            name=f"{name}_xpu" + "".join(f"_{d.lower()}" for d in defs),  # one cached build per define set
+            sources=[os.path.join(here, f"{name}.sycl")],
+            extra_cflags=["-O3"],
+            extra_sycl_cflags=(["-O3", "-ffast-math"] if fast_math else ["-O3", "-fno-fast-math"])
+            + [f"-D{d}" for d in defs],
+            verbose=os.environ.get("SGLANG_XPU_SYCL_VERBOSE") == "1",
+        )
+    return mod
diff --git a/python/sglang/kernels/ops/attention/xpu_sycl/ink_attn_res.sycl b/python/sglang/kernels/ops/attention/xpu_sycl/ink_attn_res.sycl
new file mode 100644
index 00000000..5d5d891e
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/xpu_sycl/ink_attn_res.sycl
@@ -0,0 +1,215 @@
+// Inkling2 block attention-residual mix for Intel Xe2 (decode / small T).
+// out[q, t, :] = sum_s softmax_s(query_q . rmsnorm(x_s[t])) * (normalize_values ? rmsnorm(x_s[t]) : x_s[t])
+// with the optional addend joining the last source. One work-group of D/8 work-items per token:
+// every work-item holds 8 contiguous elements of all S sources (one 32-byte load each, all in
+// flight at once), the S*(1+NQ) partial sums are reduced in one sub-group + SLM pass.
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#include <torch/extension.h>
+
+#include <vector>
+
+namespace {
+
+constexpr int SG = 16;
+constexpr int MAXS = 12;
+constexpr int MAXQ = 3;
+constexpr int MAXV = MAXS * (1 + MAXQ);  // partial sums per work-item
+
+inline float bf16f(uint16_t x) { return sycl::bit_cast<float>(uint32_t(x) << 16); }
+
+template <int S, int NQ, bool ADD_BF16>
+struct AttnRes {
+  const float* src[MAXS];
+  const void* add;  // nullptr = no addend
+  const float* q;   // [NQ, D]
+  float* out;       // [NQ, T, D]
+  int T, D;
+  int64_t sx, sadd;
+  float eps;
+  bool norm_v;
+
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<1> it, float* slm) const {
+    auto sg = it.get_sub_group();
+    const int t = it.get_group(0);
+    const int li = it.get_local_linear_id();
+    const int lane = sg.get_local_linear_id(), sgid = sg.get_group_linear_id(), nsg = sg.get_group_linear_range();
+    const int d0 = li * 8;
+    const bool act = d0 < D;
+    float x[S][8];
+#pragma unroll
+    for (int s = 0; s < S; ++s) {
+      if (act) {
+        const auto v = *reinterpret_cast<const sycl::vec<float, 8>*>(src[s] + int64_t(t) * sx + d0);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) x[s][j] = v[j];
+      } else {
+#pragma unroll
+        for (int j = 0; j < 8; ++j) x[s][j] = 0.f;
+      }
+    }
+    if (add != nullptr && act) {
+      if constexpr (ADD_BF16) {
+        const auto v = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(static_cast<const uint16_t*>(add) + int64_t(t) * sadd + d0);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) x[S - 1][j] += bf16f(v[j]);
+      } else {
+        const auto v = *reinterpret_cast<const sycl::vec<float, 8>*>(static_cast<const float*>(add) + int64_t(t) * sadd + d0);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) x[S - 1][j] += v[j];
+      }
+    }
+    float qv[NQ][8];
+#pragma unroll
+    for (int qi = 0; qi < NQ; ++qi) {
+      if (act) {
+        const auto v = *reinterpret_cast<const sycl::vec<float, 8>*>(q + int64_t(qi) * D + d0);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) qv[qi][j] = v[j];
+      } else {
+#pragma unroll
+        for (int j = 0; j < 8; ++j) qv[qi][j] = 0.f;
+      }
+    }
+    constexpr int NV = S * (1 + NQ);
+    float part[NV];
+#pragma unroll
+    for (int s = 0; s < S; ++s) {
+      float ss = 0.f;
+#pragma unroll
+      for (int j = 0; j < 8; ++j) ss = sycl::fma(x[s][j], x[s][j], ss);
+      part[s * (1 + NQ)] = ss;
+#pragma unroll
+      for (int qi = 0; qi < NQ; ++qi) {
+        float dt = 0.f;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) dt = sycl::fma(qv[qi][j], x[s][j], dt);
+        part[s * (1 + NQ) + 1 + qi] = dt;
+      }
+    }
+#pragma unroll
+    for (int v = 0; v < NV; ++v) {
+      const float r = sycl::reduce_over_group(sg, part[v], sycl::plus<float>());
+      if (lane == 0) slm[sgid * MAXV + v] = r;
+    }
+    sycl::group_barrier(it.get_group());
+    if (sgid == 0) {
+      for (int v = lane; v < NV; v += SG) {
+        float a = 0.f;
+        for (int g = 0; g < nsg; ++g) a += slm[g * MAXV + v];
+        slm[64 * MAXV + v] = a;
+      }
+    }
+    sycl::group_barrier(it.get_group());
+    if (!act) return;
+    const float* tot = slm + 64 * MAXV;
+    float inv[S];
+#pragma unroll
+    for (int s = 0; s < S; ++s) inv[s] = sycl::rsqrt(tot[s * (1 + NQ)] / float(D) + eps);
+#pragma unroll
+    for (int qi = 0; qi < NQ; ++qi) {
+      float lg[S], mx = -INFINITY;
+#pragma unroll
+      for (int s = 0; s < S; ++s) {
+        lg[s] = tot[s * (1 + NQ) + 1 + qi] * inv[s];
+        mx = sycl::fmax(mx, lg[s]);
+      }
+      float den = 0.f;
+#pragma unroll
+      for (int s = 0; s < S; ++s) {
+        lg[s] = sycl::exp(lg[s] - mx);
+        den += lg[s];
+      }
+      const float rden = 1.f / den;
+      sycl::vec<float, 8> o;
+#pragma unroll
+      for (int j = 0; j < 8; ++j) {
+        float a = 0.f;
+#pragma unroll
+        for (int s = 0; s < S; ++s) a = sycl::fma(lg[s] * (norm_v ? inv[s] : 1.f), x[s][j], a);
+        o[j] = a * rden;
+      }
+      *reinterpret_cast<sycl::vec<float, 8>*>(out + (int64_t(qi) * T + t) * D + d0) = o;
+    }
+  }
+};
+
+template <int S, int NQ, bool ADD_BF16>
+struct Launch {
+  AttnRes<S, NQ, ADD_BF16> k;
+  sycl::local_accessor<float, 1> slm;
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<1> it) const {
+    k(it, slm.get_multi_ptr<sycl::access::decorated::no>().get());
+  }
+};
+
+template <int S, int NQ, bool ADD_BF16>
+void run(sycl::queue& q, const std::vector<torch::Tensor>& srcs, const c10::optional<torch::Tensor>& add,
+         const torch::Tensor& qs, torch::Tensor& out, bool norm_v, double eps) {
+  AttnRes<S, NQ, ADD_BF16> k{};
+  for (int s = 0; s < S; ++s) k.src[s] = srcs[s].data_ptr<float>();
+  k.add = add.has_value() ? add->data_ptr() : nullptr;
+  k.sadd = add.has_value() ? add->stride(0) : 0;
+  k.q = qs.data_ptr<float>();
+  k.out = out.data_ptr<float>();
+  k.T = srcs[0].size(0);
+  k.D = srcs[0].size(1);
+  k.sx = srcs[0].stride(0);
+  k.eps = float(eps);
+  k.norm_v = norm_v;
+  const int wg = ((k.D / 8 + SG - 1) / SG) * SG;
+  q.submit([&](sycl::handler& h) {
+    sycl::local_accessor<float, 1> slm(65 * MAXV, h);
+    h.parallel_for(sycl::nd_range<1>(int64_t(k.T) * wg, wg), Launch<S, NQ, ADD_BF16>{k, slm});
+  });
+}
+
+template <int NQ, bool AB>
+void by_s(int S, sycl::queue& q, const std::vector<torch::Tensor>& srcs, const c10::optional<torch::Tensor>& add,
+          const torch::Tensor& qs, torch::Tensor& out, bool norm_v, double eps) {
+  switch (S) {
+#define C(N) \
+  case N:    \
+    return run<N, NQ, AB>(q, srcs, add, qs, out, norm_v, eps);
+    C(1) C(2) C(3) C(4) C(5) C(6) C(7) C(8) C(9) C(10) C(11) C(12)
+#undef C
+  }
+  TORCH_CHECK(false, "S out of range");
+}
+
+}  // namespace
+
+// srcs: S fp32 [T, D] (same row stride, contiguous rows); add: optional fp32/bf16 [T, D];
+// qs: fp32 [NQ, D] (already scaled); out: fp32 [NQ, T, D]
+void ink_attn_res(std::vector<torch::Tensor> srcs, c10::optional<torch::Tensor> add, torch::Tensor qs, torch::Tensor out,
+                  bool norm_v, double eps) {
+  const int S = srcs.size();
+  TORCH_CHECK(S >= 1 && S <= MAXS);
+  const int NQ = qs.size(0);
+  TORCH_CHECK(NQ >= 1 && NQ <= MAXQ && qs.scalar_type() == at::kFloat && qs.is_contiguous());
+  const int D = srcs[0].size(1);
+  TORCH_CHECK(D % 8 == 0 && D / 8 <= 64 * SG, "D");
+  for (auto& s : srcs)
+    TORCH_CHECK(s.scalar_type() == at::kFloat && s.dim() == 2 && s.stride(1) == 1 && s.stride(0) == srcs[0].stride(0) &&
+                s.size(1) == D && s.size(0) == srcs[0].size(0) && reinterpret_cast<uintptr_t>(s.data_ptr()) % 32 == 0 &&
+                s.stride(0) % 8 == 0);
+  bool ab = false;
+  if (add.has_value()) {
+    TORCH_CHECK(add->dim() == 2 && add->stride(1) == 1 && add->size(1) == D && add->stride(0) % 8 == 0);
+    TORCH_CHECK(add->scalar_type() == at::kFloat || add->scalar_type() == at::kBFloat16);
+    ab = add->scalar_type() == at::kBFloat16;
+  }
+  TORCH_CHECK(out.scalar_type() == at::kFloat && out.is_contiguous());
+  auto& q = c10::xpu::getCurrentXPUStream().queue();
+  if (NQ == 1) {
+    if (ab) by_s<1, true>(S, q, srcs, add, qs, out, norm_v, eps);
+    else by_s<1, false>(S, q, srcs, add, qs, out, norm_v, eps);
+  } else if (NQ == 3) {
+    if (ab) by_s<3, true>(S, q, srcs, add, qs, out, norm_v, eps);
+    else by_s<3, false>(S, q, srcs, add, qs, out, norm_v, eps);
+  } else {
+    TORCH_CHECK(false, "NQ must be 1 or 3");
+  }
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("ink_attn_res", &ink_attn_res); }
diff --git a/python/sglang/kernels/ops/attention/xpu_sycl/ink_decode.sycl b/python/sglang/kernels/ops/attention/xpu_sycl/ink_decode.sycl
new file mode 100644
index 00000000..824745e9
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/xpu_sycl/ink_decode.sycl
@@ -0,0 +1,316 @@
+// Split-KV GQA decode attention for Intel Xe2 (Arc Pro B70), fp8 e4m3 KV, head dim 128,
+// optional Inkling relative bias over the last R positions. One sub-group (16 lanes) walks
+// 16-key chunks; lane l owns dims [8l, 8l+8). fp8 -> fp16 is a bit shuffle (exact, value * 2^-8),
+// scale folded into q (K) and the output (V). Scores of a chunk are reduce-scattered so lane j
+// holds key j; online softmax per lane; P.V broadcasts p_j across the sub-group. NSG sub-groups
+// of a work-group share one split range and merge through SLM; with one split the kernel writes
+// the final bf16 output and natural-log LSE, else fp32 partials + log2 LSE for a merge pass.
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#include <torch/extension.h>
+
+namespace {
+
+constexpr int SG = 16;
+constexpr int D = 128;
+constexpr int DL = D / SG;  // 8 dims per lane
+constexpr float NEG_INF = -INFINITY;
+
+inline float bf16_to_f32(uint16_t x) { return sycl::bit_cast<float>(uint32_t(x) << 16); }
+
+inline uint16_t f32_to_bf16(float f) {
+  uint32_t u = sycl::bit_cast<uint32_t>(f);
+  u += 0x7FFFu + ((u >> 16) & 1u);  // round to nearest even (no NaN inputs here)
+  return uint16_t(u >> 16);
+}
+
+// 4 fp8 e4m3 bytes -> 4 floats scaled by 2^-8 (exact, subnormals included).
+inline void cvt4(uint32_t x, float* o) {
+  uint32_t a = (x & 0xFFu) | ((x & 0xFF00u) << 8);
+  uint32_t b = ((x >> 16) & 0xFFu) | ((x >> 8) & 0xFF0000u);
+  uint32_t ha = ((a & 0x00800080u) << 8) | ((a & 0x007F007Fu) << 7);
+  uint32_t hb = ((b & 0x00800080u) << 8) | ((b & 0x007F007Fu) << 7);
+  auto h2a = sycl::bit_cast<sycl::vec<sycl::half, 2>>(ha);
+  auto h2b = sycl::bit_cast<sycl::vec<sycl::half, 2>>(hb);
+  o[0] = float(h2a[0]);
+  o[1] = float(h2a[1]);
+  o[2] = float(h2b[0]);
+  o[3] = float(h2b[1]);
+}
+
+inline void cvt8(sycl::vec<uint32_t, 2> r, float* o) {
+  cvt4(r[0], o);
+  cvt4(r[1], o + 4);
+}
+
+template <typename IDX, int G, int NSG, bool HAS_REL>
+struct InkDecode {
+  const uint16_t* q;
+  const uint8_t* k;
+  const uint8_t* v;
+  const int32_t* kv_indptr;
+  const IDX* kv_indices;
+  const uint16_t* rel;
+  uint16_t* o;
+  float* lse;
+  float* mid_o;
+  float* mid_l;
+  int64_t sqb, sqh, skt, skh, svt, svh, srb, srh, sob, soh, slb;
+  int64_t smb, smh, sms;  // mid_o strides (elements); mid_l uses the same divided by D
+  int rel_len, num_splits;
+  float scale_log2, rel_log2, out_scale;
+  sycl::local_accessor<float, 1> slm;
+
+  [[sycl::reqd_sub_group_size(SG)]] void operator()(sycl::nd_item<3> it) const {
+    auto sg = it.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int sgid = sg.get_group_linear_id();
+    const int64_t b = it.get_group(0);
+    const int g = it.get_group(1);
+    const int s = it.get_group(2);
+
+    const int kv_start = kv_indptr[b];
+    const int L = kv_indptr[b + 1] - kv_start;
+    const int per = ((L + num_splits - 1) / num_splits + SG - 1) / SG * SG;
+    const int lo = s * per;
+    const int hi = sycl::min(lo + per, L);
+    if (hi <= lo) return;  // whole work-group exits together
+    const int qpos = L - 1;
+
+    float qf[G][DL];
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+      const uint16_t* qp = q + b * sqb + int64_t(g * G + h) * sqh + lane * DL;
+      sycl::vec<uint16_t, 8> qv = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(qp);
+#pragma unroll
+      for (int d = 0; d < DL; ++d) qf[h][d] = bf16_to_f32(qv[d]) * scale_log2;
+    }
+    float m[G], lsum[G], acc[G][DL];
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+      m[h] = NEG_INF;
+      lsum[h] = 0.f;
+#pragma unroll
+      for (int d = 0; d < DL; ++d) acc[h][d] = 0.f;
+    }
+    const uint8_t* kb = k + int64_t(g) * skh + lane * DL;
+    const uint8_t* vb = v + int64_t(g) * svh + lane * DL;
+    const IDX* idx = kv_indices + kv_start;
+
+    for (int c = lo + sgid * SG; c < hi; c += NSG * SG) {
+      const int n = c + lane;
+      const bool valid = n < hi;
+      const int64_t slot = int64_t(idx[valid ? n : c]);
+      sycl::vec<uint32_t, 2> kr[SG], vr[SG];
+#pragma unroll
+      for (int j = 0; j < SG; ++j) {
+        const int64_t sj = sycl::select_from_group(sg, slot, j);
+        kr[j] = *reinterpret_cast<const sycl::vec<uint32_t, 2>*>(kb + sj * skt);
+        vr[j] = *reinterpret_cast<const sycl::vec<uint32_t, 2>*>(vb + sj * svt);
+      }
+      // partial scores, then reduce-scatter so lane j ends with key j's full score
+      float sc[G][SG];
+#pragma unroll
+      for (int j = 0; j < SG; ++j) {
+        float kf[DL];
+        cvt8(kr[j], kf);
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+          float a = 0.f;
+#pragma unroll
+          for (int d = 0; d < DL; ++d) a = sycl::fma(qf[h][d], kf[d], a);
+          sc[h][j] = a;
+        }
+      }
+#pragma unroll
+      for (int w = SG / 2; w >= 1; w /= 2) {
+        const bool up = lane & w;
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+#pragma unroll
+          for (int i = 0; i < w; ++i) {
+            const float keep = up ? sc[h][w + i] : sc[h][i];
+            const float send = up ? sc[h][i] : sc[h][w + i];
+            sc[h][i] = keep + sycl::permute_group_by_xor(sg, send, w);
+          }
+        }
+      }
+      float p[G];
+#pragma unroll
+      for (int h = 0; h < G; ++h) {
+        float sv = valid ? sc[h][0] : NEG_INF;
+        if constexpr (HAS_REL) {
+          const int dist = qpos - n;
+          if (valid && dist < rel_len)
+            sv += bf16_to_f32(rel[b * srb + int64_t(g * G + h) * srh + dist]) * rel_log2;
+        }
+        const float mt = sycl::reduce_over_group(sg, sv, sycl::maximum<float>());
+        const float mn = sycl::fmax(m[h], mt);
+        const float alpha = sycl::exp2(m[h] - mn);
+        p[h] = sycl::exp2(sv - mn);
+        lsum[h] = lsum[h] * alpha + p[h];
+        m[h] = mn;
+#pragma unroll
+        for (int d = 0; d < DL; ++d) acc[h][d] *= alpha;
+      }
+#pragma unroll
+      for (int j = 0; j < SG; ++j) {
+        float vf[DL];
+        cvt8(vr[j], vf);
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+          const float pj = sycl::select_from_group(sg, p[h], j);
+#pragma unroll
+          for (int d = 0; d < DL; ++d) acc[h][d] = sycl::fma(pj, vf[d], acc[h][d]);
+        }
+      }
+    }
+#pragma unroll
+    for (int h = 0; h < G; ++h) lsum[h] = sycl::reduce_over_group(sg, lsum[h], sycl::plus<float>());
+
+    // merge sub-groups through SLM: [NSG][G][2 + D]
+    constexpr int REC = 2 + D;
+    if constexpr (NSG > 1) {
+#pragma unroll
+      for (int h = 0; h < G; ++h) {
+        float* r = &slm[(sgid * G + h) * REC];
+        if (lane == 0) {
+          r[0] = m[h];
+          r[1] = lsum[h];
+        }
+#pragma unroll
+        for (int d = 0; d < DL; ++d) r[2 + lane * DL + d] = acc[h][d];
+      }
+      sycl::group_barrier(it.get_group());
+      for (int h = sgid; h < G; h += NSG) {
+        float M = NEG_INF;
+        for (int t = 0; t < NSG; ++t) M = sycl::fmax(M, slm[(t * G + h) * REC]);
+        float den = 0.f, num[DL];
+#pragma unroll
+        for (int d = 0; d < DL; ++d) num[d] = 0.f;
+        for (int t = 0; t < NSG; ++t) {
+          const float* r = &slm[(t * G + h) * REC];
+          const float w = r[0] == NEG_INF ? 0.f : sycl::exp2(r[0] - M);
+          den += w * r[1];
+#pragma unroll
+          for (int d = 0; d < DL; ++d) num[d] += w * r[2 + lane * DL + d];
+        }
+        write(b, g * G + h, s, M, den, num, lane);
+      }
+    } else {
+#pragma unroll
+      for (int h = 0; h < G; ++h) write(b, g * G + h, s, m[h], lsum[h], acc[h], lane);
+    }
+  }
+
+  inline void write(int64_t b, int head, int s, float M, float den, const float* num, int lane) const {
+    const float inv = 1.f / den;
+    if (num_splits == 1) {
+      sycl::vec<uint16_t, 8> ov;
+#pragma unroll
+      for (int d = 0; d < DL; ++d) ov[d] = f32_to_bf16(num[d] * inv * out_scale);
+      *reinterpret_cast<sycl::vec<uint16_t, 8>*>(o + b * sob + head * soh + lane * DL) = ov;
+      if (lse != nullptr && lane == 0) lse[b * slb + head] = (M + sycl::log2(den)) * 0.6931471805599453f;
+    } else {
+      const int64_t off = b * smb + head * smh + s * sms;
+      sycl::vec<float, 8> ov;
+#pragma unroll
+      for (int d = 0; d < DL; ++d) ov[d] = num[d] * inv;
+      *reinterpret_cast<sycl::vec<float, 8>*>(mid_o + off + lane * DL) = ov;
+      if (lane == 0) mid_l[off / D] = M + sycl::log2(den);
+    }
+  }
+};
+
+template <typename IDX, int G, int NSG, bool HAS_REL>
+void launch(sycl::queue& queue, const torch::Tensor& q, const torch::Tensor& k, const torch::Tensor& v,
+            const torch::Tensor& kv_indptr, const torch::Tensor& kv_indices, const c10::optional<torch::Tensor>& rel,
+            torch::Tensor& o, const c10::optional<torch::Tensor>& lse, const c10::optional<torch::Tensor>& mid_o,
+            const c10::optional<torch::Tensor>& mid_l, int num_splits, float scale_log2, float out_scale) {
+  const int64_t B = q.size(0), KV = k.size(-2);
+  using K = InkDecode<IDX, G, NSG, HAS_REL>;
+  K kern{};
+  kern.q = reinterpret_cast<const uint16_t*>(q.data_ptr());
+  kern.k = reinterpret_cast<const uint8_t*>(k.data_ptr());
+  kern.v = reinterpret_cast<const uint8_t*>(v.data_ptr());
+  kern.kv_indptr = kv_indptr.data_ptr<int32_t>();
+  kern.kv_indices = reinterpret_cast<const IDX*>(kv_indices.data_ptr());
+  kern.rel = rel ? reinterpret_cast<const uint16_t*>(rel->data_ptr()) : nullptr;
+  kern.o = reinterpret_cast<uint16_t*>(o.data_ptr());
+  kern.lse = lse ? lse->data_ptr<float>() : nullptr;
+  kern.mid_o = mid_o ? mid_o->data_ptr<float>() : nullptr;
+  kern.mid_l = mid_l ? mid_l->data_ptr<float>() : nullptr;
+  kern.sqb = q.stride(0);
+  kern.sqh = q.stride(1);
+  kern.skt = k.stride(0);
+  kern.skh = k.stride(-2);
+  kern.svt = v.stride(0);
+  kern.svh = v.stride(-2);
+  kern.srb = rel ? rel->stride(0) : 0;
+  kern.srh = rel ? rel->stride(1) : 0;
+  kern.rel_len = rel ? int(rel->size(2)) : 0;
+  kern.sob = o.stride(0);
+  kern.soh = o.stride(1);
+  kern.slb = lse ? lse->stride(0) : 0;
+  kern.smb = mid_o ? mid_o->stride(0) : 0;
+  kern.smh = mid_o ? mid_o->stride(1) : 0;
+  kern.sms = mid_o ? mid_o->stride(2) : 0;
+  kern.num_splits = num_splits;
+  kern.scale_log2 = scale_log2;
+  kern.rel_log2 = 1.4426950408889634f;
+  kern.out_scale = out_scale;
+  sycl::range<3> local(1, 1, NSG * SG), global(B, KV, int64_t(num_splits) * NSG * SG);
+  queue.submit([&](sycl::handler& h) {
+    kern.slm = sycl::local_accessor<float, 1>(sycl::range<1>(NSG > 1 ? NSG * G * (2 + D) : 1), h);
+    h.parallel_for(sycl::nd_range<3>(global, local), kern);
+  });
+}
+
+template <typename IDX, int G, bool HAS_REL>
+void by_nsg(int nsg, sycl::queue& qu, const torch::Tensor& q, const torch::Tensor& k, const torch::Tensor& v,
+            const torch::Tensor& ip, const torch::Tensor& ix, const c10::optional<torch::Tensor>& rel, torch::Tensor& o,
+            const c10::optional<torch::Tensor>& lse, const c10::optional<torch::Tensor>& mo,
+            const c10::optional<torch::Tensor>& ml, int S, float sc, float os) {
+  switch (nsg) {
+    case 1: return launch<IDX, G, 1, HAS_REL>(qu, q, k, v, ip, ix, rel, o, lse, mo, ml, S, sc, os);
+    case 2: return launch<IDX, G, 2, HAS_REL>(qu, q, k, v, ip, ix, rel, o, lse, mo, ml, S, sc, os);
+    case 4: return launch<IDX, G, 4, HAS_REL>(qu, q, k, v, ip, ix, rel, o, lse, mo, ml, S, sc, os);
+    case 8: return launch<IDX, G, 8, HAS_REL>(qu, q, k, v, ip, ix, rel, o, lse, mo, ml, S, sc, os);
+    case 16: return launch<IDX, G, 16, HAS_REL>(qu, q, k, v, ip, ix, rel, o, lse, mo, ml, S, sc, os);
+    case 32: return launch<IDX, G, 32, HAS_REL>(qu, q, k, v, ip, ix, rel, o, lse, mo, ml, S, sc, os);
+    case 64: return launch<IDX, G, 64, HAS_REL>(qu, q, k, v, ip, ix, rel, o, lse, mo, ml, S, sc, os);
+    default: TORCH_CHECK(false, "nsg must be 1/2/4/8/16/32/64");
+  }
+}
+
+}  // namespace
+
+// sm_scale already includes k_scale; out_scale includes v_scale. Both get the fp8->fp16 2^8 here.
+void ink_decode(torch::Tensor q, torch::Tensor k, torch::Tensor v, torch::Tensor kv_indptr, torch::Tensor kv_indices,
+                c10::optional<torch::Tensor> rel, torch::Tensor o, c10::optional<torch::Tensor> lse,
+                c10::optional<torch::Tensor> mid_o, c10::optional<torch::Tensor> mid_l, int64_t num_splits,
+                int64_t nsg, double sm_scale, double v_scale) {
+  TORCH_CHECK(q.scalar_type() == at::kBFloat16 && o.scalar_type() == at::kBFloat16, "q/o must be bf16");
+  TORCH_CHECK(k.element_size() == 1 && v.element_size() == 1, "k/v must be fp8");
+  TORCH_CHECK(q.size(-1) == D && q.stride(-1) == 1 && k.stride(-1) == 1 && v.stride(-1) == 1, "head dim 128, contiguous");
+  TORCH_CHECK(kv_indptr.scalar_type() == at::kInt, "kv_indptr int32");
+  TORCH_CHECK(num_splits == 1 || (mid_o && mid_l), "num_splits > 1 needs mid_o/mid_l");
+  const int G = q.size(1) / k.size(-2);
+  TORCH_CHECK(G == 3, "only 3 q heads per kv head are instantiated");
+  if (rel) TORCH_CHECK(rel->scalar_type() == at::kBFloat16 && rel->stride(-1) == 1 && rel->dim() == 3, "rel [B,H,R] bf16");
+  auto& qu = c10::xpu::getCurrentXPUStream().queue();
+  const float sc = float(sm_scale * 256.0 * 1.4426950408889634);
+  const float os = float(v_scale * 256.0);
+  const int S = int(num_splits), N = int(nsg);
+  const bool i64 = kv_indices.scalar_type() == at::kLong;
+  TORCH_CHECK(i64 || kv_indices.scalar_type() == at::kInt, "kv_indices int32/int64");
+  if (i64) {
+    if (rel) by_nsg<int64_t, 3, true>(N, qu, q, k, v, kv_indptr, kv_indices, rel, o, lse, mid_o, mid_l, S, sc, os);
+    else by_nsg<int64_t, 3, false>(N, qu, q, k, v, kv_indptr, kv_indices, rel, o, lse, mid_o, mid_l, S, sc, os);
+  } else {
+    if (rel) by_nsg<int32_t, 3, true>(N, qu, q, k, v, kv_indptr, kv_indices, rel, o, lse, mid_o, mid_l, S, sc, os);
+    else by_nsg<int32_t, 3, false>(N, qu, q, k, v, kv_indptr, kv_indices, rel, o, lse, mid_o, mid_l, S, sc, os);
+  }
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("ink_decode", &ink_decode); }
