index 98540169..c354175b 100644
--- a/python/sglang/kernels/ops/attention/score_mod.py
+++ b/python/sglang/kernels/ops/attention/score_mod.py
@@ -54,3 +54,19 @@ def relative_bias_score_mod(
         other=0.0,
     )
     return qk + bias
+
+
+@triton.jit
+def relative_bias_rev_score_mod(
+    qk, q_pos, kv_pos, q_idx, head, mask, Aux0, aux0_stride_t, aux0_stride_h, aux0_len
+):
+    """relative_bias_score_mod with Aux0 reversed on its last dim
+    (Aux0[t, h, aux0_len - 1 - d]): the index aux0_len - 1 - q_pos + kv_pos ascends
+    with kv_pos, so each row's bias loads are contiguous (vectorizable)."""
+    idx = (aux0_len - 1) - q_pos + kv_pos
+    bias = tl.load(
+        Aux0 + q_idx * aux0_stride_t + head * aux0_stride_h + idx,
+        mask=mask & (idx >= 0) & (idx < aux0_len),
+        other=0.0,
+    )
+    return qk + bias
