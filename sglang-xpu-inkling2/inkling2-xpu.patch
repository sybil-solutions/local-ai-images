+Semantics match decode_attention_fwd(..., score_mod=relative_bias_score_mod): bias index is
+(L - 1) - kv_pos for kv_pos in the request's kv list, applied when 0 <= idx < rel_len.
+Stage 1 splits each request's keys into `num_splits` ranges, one program per (request, kv head,
+split); the tiles before the bias window run a loop without the bias gather. Stage 2 merges all
+splits of one (request, head) in a single vector load instead of a serial loop.
+"""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+_LOG2E = 1.4426950408889634
+
+
+@triton.jit
+def _tiles(q, m_i, l_i, acc, k_base, v_base, kv_idx, Rel_row, n_from, n_to, hi, qpos, rel_len,
+           sm_scale_log2, rel_scale_log2, stride_kt, stride_vt, stride_rh, n_slots, mh,
+           BLOCK_N: tl.constexpr, D: tl.constexpr, HAS_REL: tl.constexpr, BLOCKPTR: tl.constexpr,
+           UPCAST: tl.constexpr, STAGES: tl.constexpr):
+    offs_d = tl.arange(0, D)
+    for n0 in tl.range(n_from, n_to, BLOCK_N, num_stages=STAGES):
+        offs_n = n0 + tl.arange(0, BLOCK_N)
+        mn = offs_n < hi
+        if BLOCKPTR:
+            first = tl.load(kv_idx + n0)
+            kp = tl.make_block_ptr(k_base, (n_slots, D), (stride_kt, 1), (first, 0), (BLOCK_N, D), (1, 0))
+            vp = tl.make_block_ptr(v_base, (n_slots, D), (stride_vt, 1), (first, 0), (BLOCK_N, D), (1, 0))
+            k = tl.load(kp, boundary_check=(0,))
+            v = tl.load(vp, boundary_check=(0,))
+        else:
+            loc = tl.load(kv_idx + offs_n, mask=mn, other=0).to(tl.int64)
+            k = tl.load(k_base + loc[:, None] * stride_kt + offs_d[None, :], mask=mn[:, None], other=0.0)
+            v = tl.load(v_base + loc[:, None] * stride_vt + offs_d[None, :], mask=mn[:, None], other=0.0)
+        if UPCAST:
+            k = k.to(q.dtype)
+            v = v.to(q.dtype)
+        qk = tl.dot(q, tl.trans(k)) * sm_scale_log2
+        if HAS_REL:
+            dist = qpos - offs_n
+            rm = mh[:, None] & mn[None, :] & (dist[None, :] < rel_len)
+            bias = tl.load(Rel_row + dist[None, :], mask=rm, other=0.0)
+            qk += bias.to(tl.float32) * rel_scale_log2
+        qk = tl.where(mn[None, :], qk, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(qk, 1))
+        alpha = tl.exp2(m_i - m_new)
+        p = tl.exp2(qk - m_new[:, None])
+        if BLOCKPTR:
+            # block loads past the range read neighbouring slots (maybe NaN bit patterns)
+            v = tl.where(mn[:, None], v, 0.0)
+        l_i = l_i * alpha + tl.sum(p, 1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(v.dtype), v)
+        m_i = m_new
+    return m_i, l_i, acc
+
+
+@triton.jit
+def _ink_decode_stage1(
+    Q, K, V, kv_indptr, kv_indices, Rel, Mid_O, Mid_L,
+    sm_scale_log2, rel_scale_log2, num_splits,
+    stride_qb, stride_qh, stride_kt, stride_kh, stride_vt, stride_vh,
+    stride_rb, stride_rh, rel_len,
+    stride_mb, stride_mh, stride_ms,
+    n_slots,
+    GROUP: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_N: tl.constexpr, D: tl.constexpr,
+    HAS_REL: tl.constexpr, BLOCKPTR: tl.constexpr, UPCAST: tl.constexpr, STAGES: tl.constexpr,
+):
+    b = tl.program_id(0).to(tl.int64)
+    g = tl.program_id(1)
+    s = tl.program_id(2)
+    kv_start = tl.load(kv_indptr + b)
+    L = tl.load(kv_indptr + b + 1) - kv_start
+    per = tl.cdiv(tl.cdiv(L, num_splits), BLOCK_N) * BLOCK_N
+    lo = s * per
+    hi = tl.minimum(lo + per, L)
+    offs_h = tl.arange(0, BLOCK_H)
+    mh = offs_h < GROUP
+    heads = g * GROUP + offs_h
+    offs_d = tl.arange(0, D)
+    if hi > lo:
+        q = tl.load(Q + b * stride_qb + heads[:, None] * stride_qh + offs_d[None, :], mask=mh[:, None], other=0.0)
+        m_i = tl.zeros([BLOCK_H], dtype=tl.float32) - float("inf")
+        l_i = tl.zeros([BLOCK_H], dtype=tl.float32)
+        acc = tl.zeros([BLOCK_H, D], dtype=tl.float32)
+        qpos = L - 1
+        k_base = K + g * stride_kh
+        v_base = V + g * stride_vh
+        kv_idx = kv_indices + kv_start
+        Rel_row = Rel + b * stride_rb + heads[:, None] * stride_rh
+        if HAS_REL:
+            # first tile that holds a key within rel_len of the query
+            rel_lo = tl.minimum(tl.maximum(lo + ((qpos - rel_len + 1 - lo) // BLOCK_N) * BLOCK_N, lo), hi)
+        else:
+            rel_lo = hi
+        m_i, l_i, acc = _tiles(q, m_i, l_i, acc, k_base, v_base, kv_idx, Rel_row, lo, rel_lo, hi, qpos,
+                               rel_len, sm_scale_log2, rel_scale_log2, stride_kt, stride_vt, stride_rh,
+                               n_slots, mh, BLOCK_N, D, False, BLOCKPTR, UPCAST, STAGES)
+        if HAS_REL:
+            m_i, l_i, acc = _tiles(q, m_i, l_i, acc, k_base, v_base, kv_idx, Rel_row, rel_lo, hi, hi, qpos,
+                                   rel_len, sm_scale_log2, rel_scale_log2, stride_kt, stride_vt, stride_rh,
+                                   n_slots, mh, BLOCK_N, D, True, BLOCKPTR, UPCAST, STAGES)
+        out_off = b * stride_mb + heads[:, None] * stride_mh + s * stride_ms + offs_d[None, :]
+        tl.store(Mid_O + out_off, acc / l_i[:, None], mask=mh[:, None])
+        tl.store(Mid_L + (b * stride_mb + heads * stride_mh + s * stride_ms) // D, m_i + tl.log2(l_i), mask=mh)
+
+
+@triton.jit
+def _ink_decode_stage2(
+    Mid_O, Mid_L, O, Lse, kv_indptr, num_splits, v_scale,
+    stride_mb, stride_mh, stride_ms, stride_ob, stride_oh, stride_lb,
+    BLOCK_N: tl.constexpr, MAX_S: tl.constexpr, D: tl.constexpr, WRITE_LSE: tl.constexpr,
+):
+    b = tl.program_id(0).to(tl.int64)
+    h = tl.program_id(1)
+    L = tl.load(kv_indptr + b + 1) - tl.load(kv_indptr + b)
+    per = tl.maximum(tl.cdiv(tl.cdiv(L, num_splits), BLOCK_N) * BLOCK_N, BLOCK_N)
+    used = tl.cdiv(L, per)  # 0 for an empty (graph-padding) request: writes zeros
+    offs_s = tl.arange(0, MAX_S)
+    ms = offs_s < used
+    base = b * stride_mb + h * stride_mh
+    lse = tl.load(Mid_L + (base + offs_s * stride_ms) // D, mask=ms, other=-float("inf"))
+    m = tl.max(lse, 0)
+    w = tl.where(ms, tl.exp2(lse - m), 0.0)
+    tot = tl.sum(w, 0)
+    offs_d = tl.arange(0, D)
+    o = tl.load(Mid_O + base + offs_s[:, None] * stride_ms + offs_d[None, :], mask=ms[:, None], other=0.0)
+    out = tl.where(tot > 0, tl.sum(o * w[:, None], 0) / tot, 0.0)
+    tl.store(O + b * stride_ob + h * stride_oh + offs_d, (out * v_scale).to(O.dtype.element_ty))
+    if WRITE_LSE:
+        tl.store(Lse + b * stride_lb + h, (m + tl.log2(tot)) * 0.6931471805599453)
+
+
+def _env(name, default):
+    return int(os.environ.get("SGLANG_XPU_INK_DEC_" + name, default))
+
+
+def inkling_decode_attention_xpu(
+    q, k_buffer, v_buffer, o, kv_indptr, kv_indices, mid_o, mid_l, num_splits: int,
+    sm_scale: float, k_scale: float = 1.0, v_scale: float = 1.0, rel=None, lse_out=None,
+    block_n=None, block_h=None, warps=None, stages=None, blockptr=None, only=0,
+):
+    """q [B, H, D]; k/v_buffer [slots, KV, D]; o [B, H, D]; mid_o [B, H, >=S, D] fp32;
+    mid_l [B, H, >=S] fp32 (same leading strides as mid_o // D); rel [B, H, rel_len] or None.
+    blockptr=1 assumes every request's kv slots are one contiguous run (benchmark only)."""
+    B, H, D = q.shape
+    KV = k_buffer.shape[-2]
+    group = H // KV
+    block_n = block_n or _env("BLOCK_N", 32)
+    block_h = block_h or _env("BLOCK_H", 16)
+    warps = warps or _env("WARPS", 4)
+    stages = stages if stages is not None else _env("STAGES", 2)
+    blockptr = blockptr if blockptr is not None else _env("BLOCKPTR", 0)
+    assert mid_o.shape[2] >= num_splits and mid_o.stride(-1) == 1
+    if rel is not None:
+        rel = rel.reshape(B, H, -1)
+        rel_args = (rel, rel.stride(0), rel.stride(1), rel.shape[-1])
+    else:
+        rel_args = (q, 0, 0, 0)
+    k1 = None
+    if only != 2:
+        k1 = _ink_decode_stage1[(B, KV, num_splits)](
+            q, k_buffer, v_buffer, kv_indptr, kv_indices, rel_args[0], mid_o, mid_l,
+            sm_scale * k_scale * _LOG2E, _LOG2E, num_splits,
+            q.stride(0), q.stride(1), k_buffer.stride(0), k_buffer.stride(1),
+            v_buffer.stride(0), v_buffer.stride(1),
+            rel_args[1], rel_args[2], rel_args[3],
+            mid_o.stride(0), mid_o.stride(1), mid_o.stride(2),
+            k_buffer.shape[0],
+            GROUP=group, BLOCK_H=max(block_h, triton.next_power_of_2(group)), BLOCK_N=block_n, D=D,
+            HAS_REL=rel is not None, BLOCKPTR=bool(blockptr), UPCAST=k_buffer.dtype != q.dtype,
+            STAGES=stages, num_warps=warps,
+        )
+    if only != 1:
+        _ink_decode_stage2[(B, H)](
+            mid_o, mid_l, o, lse_out if lse_out is not None else mid_l, kv_indptr, num_splits, v_scale,
+            mid_o.stride(0), mid_o.stride(1), mid_o.stride(2), o.stride(0), o.stride(1),
+            lse_out.stride(0) if lse_out is not None else 0,
+            BLOCK_N=block_n, MAX_S=triton.next_power_of_2(num_splits), D=D, WRITE_LSE=lse_out is not None,
+            num_warps=4,
+        )
+    return k1
+
+
+def inkling_decode_attention_sycl(
+    q, k_buffer, v_buffer, o, kv_indptr, kv_indices, mid_o, mid_l, num_splits: int,
+    sm_scale: float, k_scale: float = 1.0, v_scale: float = 1.0, rel=None, lse_out=None, nsg: int = 8,
+):
+    """SYCL variant (xpu_sycl/ink_decode.sycl); same contract as inkling_decode_attention_xpu."""
+    from sglang.kernels.ops.attention.xpu_sycl import ink_decode_ext
+
+    B, H, D = q.shape
+    if rel is not None:
+        rel = rel.reshape(B, H, -1)
+    if num_splits == 1:
+        ink_decode_ext().ink_decode(q, k_buffer, v_buffer, kv_indptr, kv_indices, rel, o, lse_out, None, None,
+                                    1, nsg, sm_scale * k_scale, v_scale)
+        return
+    ink_decode_ext().ink_decode(q, k_buffer, v_buffer, kv_indptr, kv_indices, rel, o, None, mid_o, mid_l,
+                                num_splits, nsg, sm_scale * k_scale, v_scale)
+    _ink_decode_stage2[(B, H)](
+        mid_o, mid_l, o, lse_out if lse_out is not None else mid_l, kv_indptr, num_splits, v_scale * 256.0,
+        mid_o.stride(0), mid_o.stride(1), mid_o.stride(2), o.stride(0), o.stride(1),
+        lse_out.stride(0) if lse_out is not None else 0,
+        BLOCK_N=16, MAX_S=triton.next_power_of_2(num_splits), D=D, WRITE_LSE=lse_out is not None,
+        num_warps=4,
+    )
diff --git a/python/sglang/kernels/ops/attention/inkling_prefill.py b/python/sglang/kernels/ops/attention/inkling_prefill.py
new file mode 100644
index 00000000..5216df1f
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/inkling_prefill.py
@@ -0,0 +1,267 @@
+"""Gather-then-attend prefill (extend) attention for Inkling on Intel XPU.
+
+The generic extend kernel walks the paged prefix with per-row gathers (fp8 upcast
+per tile); at 32K context it runs at ~2 TFLOPS and is 58% of prefill time. Here the
+layer's prefix K/V is gathered once into a contiguous bf16 buffer next to this
+chunk's K/V, then two kernels run:
+
+  far:  keys farther than the bias extent from every query of the tile -- no bias,
+        no mask: the bare flash loop with 2D block loads (K through an order-(0,1)
+        block pointer). Writes unnormalized partials (acc, m, l) in the exp2 domain.
+  near: the remaining keys (bias band, causal diagonal) with the extend kernel's
+        BAND_BIAS layout, starting from the partials; writes O and natural-log LSE.
+
+Split because on Intel's register allocator masks + the bias tile in the loop body
+spill ~40 KB and drop the far loop from 26 to 1-2 TFLOPS. Every block-pointer
+stride is a constexpr: a runtime pitch costs 11x (2D block loads lost).
+Sliding-window layers (window < bias extent) run the near kernel alone over the window rail.
+"""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.ops.attention.extend_attention import BAND_PAD
+
+A_BN = int(os.environ.get("INK_PF_A_BN", "32"))
+A_WARPS = int(os.environ.get("INK_PF_A_WARPS", "8"))
+B_BN = int(os.environ.get("INK_PF_B_BN", "16"))
+B_WARPS = int(os.environ.get("INK_PF_B_WARPS", "8"))
+BM = 64  # q tile of both kernels == the band's BLOCK_M
+LOG2E = 1.4426950408889634
+
+
+@triton.jit
+def _bounds(Qo_indptr, Kc_start, Kc_len, b, m0, EXT: tl.constexpr, BN: tl.constexpr):
+    # Qo_indptr: padded row start of request b (each request owns a tile-aligned region), then its length
+    q_start = tl.load(Qo_indptr + 2 * b)
+    q_len = tl.load(Qo_indptr + 2 * b + 1)
+    kc0 = tl.load(Kc_start + b).to(tl.int64)
+    L = tl.load(Kc_len + b)
+    P = L - q_len
+    # tile [n0, n0+BN) is far for every query of [m0, m0+BM) when (P+m0) - (n0+BN-1) >= EXT
+    near_lo = tl.maximum(P + m0 - EXT + 1, 0) // BN * BN
+    return q_start, q_len, kc0, L, P, near_lo
+
+
+@triton.jit
+def _ink_prefill_far(
+    Q, Kc, Vc, Part_O, Part_M, Part_L, Qo_indptr, Kc_start, Kc_len, sm_scale,
+    SQT: tl.constexpr, SQH: tl.constexpr, H: tl.constexpr, G: tl.constexpr, KVH: tl.constexpr, D: tl.constexpr,
+    EXT: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+):
+    mb = tl.program_id(0)
+    h = tl.program_id(1)
+    b = tl.program_id(2)
+    kh = h // G
+    m0 = mb * BM
+    q_start, q_len, kc0, L, P, near_lo = _bounds(Qo_indptr, Kc_start, Kc_len, b, m0, EXT, BN)
+    if m0 >= q_len:
+        return
+    q = tl.load(tl.make_block_ptr(Q + q_start.to(tl.int64) * SQT + h * SQH, (q_len + BM, D), (SQT, 1), (m0, 0), (BM, D), (1, 0)))
+    k_ptr = tl.make_block_ptr(Kc + kc0 * KVH * D + kh * D, (D, L), (1, KVH * D), (0, 0), (D, BN), (0, 1))
+    v_ptr = tl.make_block_ptr(Vc + kc0 * KVH * D + kh * D, (L, D), (KVH * D, 1), (0, 0), (BN, D), (1, 0))
+    m_i = tl.zeros((BM,), tl.float32) - float("inf")
+    l_i = tl.zeros((BM,), tl.float32)
+    acc = tl.zeros((BM, D), tl.float32)
+    qs = sm_scale * 1.4426950408889634
+    for n0 in range(0, near_lo, BN):
+        s = tl.dot(q, tl.load(k_ptr)) * qs
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        p = tl.exp2(s - m_new[:, None])
+        alpha = tl.exp2(m_i - m_new)
+        l_i = l_i * alpha + tl.sum(p, 1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(q.dtype), tl.load(v_ptr))
+        m_i = m_new
+        k_ptr = tl.advance(k_ptr, (0, BN))
+        v_ptr = tl.advance(v_ptr, (BN, 0))
+    offs_m = m0 + tl.arange(0, BM)
+    rows = q_start + offs_m
+    tl.store(tl.make_block_ptr(Part_O + q_start.to(tl.int64) * H * D + h * D, (q_len + BM, D), (H * D, 1), (m0, 0), (BM, D), (1, 0)), acc)
+    tl.store(Part_M + rows * H + h, m_i)
+    tl.store(Part_L + rows * H + h, l_i)
+
+
+@triton.jit
+def _ink_prefill_near(
+    Q, Kc, Vc, O, Lse, Band, Band_row, Part_O, Part_M, Part_L, Qo_indptr, Kc_start, Kc_len, sm_scale,
+    SQT: tl.constexpr, SQH: tl.constexpr, SOT: tl.constexpr, SOH: tl.constexpr,
+    BST: tl.constexpr, BSH: tl.constexpr, BW: tl.constexpr,
+    H: tl.constexpr, G: tl.constexpr, KVH: tl.constexpr, D: tl.constexpr, EXT: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, A_BN: tl.constexpr, HAS_BAND: tl.constexpr, HAS_FAR: tl.constexpr, SW: tl.constexpr,
+):
+    mb = tl.program_id(0)
+    h = tl.program_id(1)
+    b = tl.program_id(2)
+    kh = h // G
+    m0 = mb * BM
+    q_start, q_len, kc0, L, P, near_lo = _bounds(Qo_indptr, Kc_start, Kc_len, b, m0, EXT, A_BN)
+    if m0 >= q_len:
+        return
+    hi = tl.minimum(P + m0 + BM, L)
+    if SW >= 0:
+        # sliding window (SW < EXT): every visible pair is inside the bias band; keys are a window rail
+        # whose positions are contiguous, so distances are rail-index differences
+        near_lo = tl.maximum(P + m0 - SW, 0) // BN * BN
+    offs_m = m0 + tl.arange(0, BM)
+    rows = q_start + offs_m
+    q = tl.load(tl.make_block_ptr(Q + q_start.to(tl.int64) * SQT + h * SQH, (q_len + BM, D), (SQT, 1), (m0, 0), (BM, D), (1, 0)))
+    if HAS_FAR:
+        m_i = tl.load(Part_M + rows * H + h)
+        l_i = tl.load(Part_L + rows * H + h)
+        acc = tl.load(tl.make_block_ptr(Part_O + q_start.to(tl.int64) * H * D + h * D, (q_len + BM, D), (H * D, 1), (m0, 0), (BM, D), (1, 0)))
+    else:
+        m_i = tl.zeros((BM,), tl.float32) - float("inf")
+        l_i = tl.zeros((BM,), tl.float32)
+        acc = tl.zeros((BM, D), tl.float32)
+    q_pos = P + offs_m
+    qpos0 = P + m0
+    k_ptr = tl.make_block_ptr(Kc + kc0 * KVH * D + kh * D, (D, L + BN), (1, KVH * D), (0, near_lo), (D, BN), (0, 1))
+    v_ptr = tl.make_block_ptr(Vc + kc0 * KVH * D + kh * D, (L + BN, D), (KVH * D, 1), (near_lo, 0), (BN, D), (1, 0))
+    for n0 in range(near_lo, hi, BN):
+        s = tl.dot(q, tl.load(k_ptr)) * sm_scale
+        if HAS_BAND:
+            col = tl.minimum(tl.maximum(BAND_PAD + n0 - qpos0 + EXT, 0), BW - BN)
+            b_ptr = tl.make_block_ptr(Band + (tl.load(Band_row + b) + m0).to(tl.int64) * BST + h * BSH, (BM, BW), (BST, 1), (0, col), (BM, BN), (1, 0))
+            s += tl.load(b_ptr).to(tl.float32)
+        k_pos = n0 + tl.arange(0, BN)
+        keep = (k_pos[None, :] <= q_pos[:, None]) & (k_pos[None, :] < L)
+        if SW >= 0:
+            keep = keep & (q_pos[:, None] - k_pos[None, :] <= SW)
+        s = tl.where(keep, s * 1.4426950408889634, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        m_safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+        p = tl.exp2(s - m_safe[:, None])
+        alpha = tl.exp2(m_i - m_safe)
+        l_i = l_i * alpha + tl.sum(p, 1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(q.dtype), tl.load(v_ptr))
+        m_i = m_new
+        k_ptr = tl.advance(k_ptr, (0, BN))
+        v_ptr = tl.advance(v_ptr, (BN, 0))
+    l_safe = tl.where(l_i == 0.0, 1.0, l_i)
+    tl.store(tl.make_block_ptr(O + q_start.to(tl.int64) * SOT + h * SOH, (q_len + BM, D), (SOT, 1), (m0, 0), (BM, D), (1, 0)),
+             (acc / l_safe[:, None]).to(O.dtype.element_ty))
+    tl.store(Lse + rows * H + h, (m_i + tl.log2(l_safe)) / 1.4426950408889634)
+
+
+@triton.jit
+def _gather_rows(Src, Idx, Dst, n, scale, ROW: tl.constexpr, BR: tl.constexpr):
+    """Dst[r] = bf16(Src[Idx[r]] * scale) for r < n (one cache row = KVH*D elements)."""
+    rows = tl.program_id(0) * BR + tl.arange(0, BR)
+    m = rows < n
+    idx = tl.load(Idx + rows, mask=m, other=0).to(tl.int64)
+    cols = tl.arange(0, ROW)
+    x = tl.load(Src + idx[:, None] * ROW + cols[None, :], mask=m[:, None], other=0.0).to(tl.float32) * scale
+    tl.store(Dst + rows[:, None].to(tl.int64) * ROW + cols[None, :], x.to(Dst.dtype.element_ty), mask=m[:, None])
+
+
+def gather_kv(k_buf, v_buf, kv_indptr_cpu, kv_indices, k_ext, v_ext, ext_lens_cpu, k_descale=1.0, v_descale=1.0, pad=0):
+    """Contiguous bf16 [sum(prefix_b + ext_b) + pad, KVH, D] K and V, written in place (no
+    intermediate copies: at 256K context the old gather + cast + cat peaked at ~2.5 GB):
+    each request's prefix rows (paged cache, fp8 upcast, descale) then its chunk rows; the
+    pad rows are zero. Returns kc, vc, starts, lens."""
+    starts, lens, pos = [], [], 0
+    for b, e in enumerate(ext_lens_cpu):
+        starts.append(pos)
+        lens.append(kv_indptr_cpu[b + 1] - kv_indptr_cpu[b] + e)
+        pos += lens[-1]
+    shape = (pos + pad,) + tuple(k_ext.shape[1:])
+    kc = torch.empty(shape, device=k_ext.device, dtype=k_ext.dtype)
+    vc = torch.empty(shape, device=v_ext.device, dtype=v_ext.dtype)
+    row = k_ext.shape[1] * k_ext.shape[2]
+    kbf, vbf = k_buf.reshape(k_buf.shape[0], -1), v_buf.reshape(v_buf.shape[0], -1)
+    qpos = 0
+    for b, e in enumerate(ext_lens_cpu):
+        p0, p1 = kv_indptr_cpu[b], kv_indptr_cpu[b + 1]
+        o = starts[b]
+        if p1 > p0:
+            idx = kv_indices[p0:p1]
+            grid = (triton.cdiv(p1 - p0, 16),)
+            _gather_rows[grid](kbf, idx, kc[o:], p1 - p0, float(k_descale), ROW=row, BR=16)
+            _gather_rows[grid](vbf, idx, vc[o:], p1 - p0, float(v_descale), ROW=row, BR=16)
+        kc[o + p1 - p0 : o + lens[b]] = k_ext[qpos : qpos + e]
+        vc[o + p1 - p0 : o + lens[b]] = v_ext[qpos : qpos + e]
+        qpos += e
+    if pad:
+        kc[pos:].zero_()
+        vc[pos:].zero_()
+    return kc, vc, starts, lens
+
+
+_MEMLOG = int(os.environ.get("INK_MEMLOG", "0"))
+_memlog_n = [0]
+
+
+def _memlog():
+    _memlog_n[0] += 1
+    if _memlog_n[0] % _MEMLOG == 0:
+        free, total = torch.xpu.mem_get_info()
+        g = 2**30
+        print(f"[ink-mem] torch reserved {torch.xpu.memory_reserved() / g:.2f} GiB (max {torch.xpu.max_memory_reserved() / g:.2f}) "
+              f"allocated {torch.xpu.memory_allocated() / g:.2f} (max {torch.xpu.max_memory_allocated() / g:.2f}) "
+              f"device used {(total - free) / g:.2f} of {total / g:.2f} GiB", flush=True)
+
+
+def ink_prefill_attention(q, k_ext, v_ext, o, k_buf, v_buf, qo_indptr, kv_indptr, kv_indices,
+                          band, lse, *, ext_lens_cpu, sm_scale, k_descale=1.0, v_descale=1.0, ext=1024,
+                          sliding_window_size=-1):
+    """Global layers. q/o [T, H, D]; k_ext/v_ext [T, KVH, D] this chunk; k_buf/v_buf the cache;
+    kv_indptr/kv_indices the prefix list; band = BAND_BIAS tensor built for BLOCK_M 64 (or None);
+    lse contiguous [T, H] fp32 or None."""
+    if _MEMLOG:
+        _memlog()
+    T, H, D = q.shape
+    KVH = k_ext.shape[1]
+    bs = len(ext_lens_cpu)
+    kv_indptr_cpu = kv_indptr[: bs + 1].tolist()
+    kc, vc, starts, lens = gather_kv(k_buf, v_buf, kv_indptr_cpu, kv_indices, k_ext, v_ext, ext_lens_cpu, k_descale, v_descale,
+                                     pad=max(A_BN, B_BN))
+    dev = q.device
+    # Every buffer is laid out with a tile-aligned region per request: masked / boundary-checked block
+    # loads lose the 2D block-load path on Intel (34.6 -> 2.4 TFLOPS), so tiles read and write past
+    # q_len into their own region's padding instead.
+    pad_starts, meta, pos = [], [], 0
+    for e in ext_lens_cpu:
+        pad_starts.append(pos); meta += [pos, e]; pos += triton.cdiv(e, BM) * BM
+    TP = pos
+    qo_meta = torch.tensor(meta, device=dev, dtype=torch.int32)
+    band_row = qo_indptr[:bs].to(torch.int32)
+    if bs == 1:
+        rows = None
+        qp = torch.empty((TP, H, D), device=dev, dtype=q.dtype)
+        qp[:T] = q
+    else:
+        rows = torch.cat([torch.arange(p0, p0 + e, device=dev) for p0, e in zip(pad_starts, ext_lens_cpu)])
+        qp = torch.zeros((TP, H, D), device=dev, dtype=q.dtype)
+        qp[rows] = q
+    op = torch.empty_like(qp)
+    lp = torch.empty((TP, H), device=dev, dtype=torch.float32)
+    kc_start = torch.tensor(starts, device=dev, dtype=torch.int64)
+    kc_len = torch.tensor(lens, device=dev, dtype=torch.int32)
+    grid = (triton.cdiv(max(ext_lens_cpu), BM), H, bs)
+    sw = -1 if sliding_window_size is None else int(sliding_window_size)
+    assert sw < ext, "window wider than the bias extent needs the far kernel with a window"
+    has_far = sw < 0 and max(lens) > ext
+    part_o = part_m = part_l = q
+    if has_far:
+        part_o = torch.empty((TP, H, D), device=dev, dtype=torch.float32)
+        part_m = torch.empty((TP, H), device=dev, dtype=torch.float32)
+        part_l = torch.empty((TP, H), device=dev, dtype=torch.float32)
+        _ink_prefill_far[grid](
+            qp, kc, vc, part_o, part_m, part_l, qo_meta, kc_start, kc_len, float(sm_scale),
+            SQT=qp.stride(0), SQH=qp.stride(1), H=H, G=H // KVH, KVH=KVH, D=D, EXT=ext, BM=BM, BN=A_BN, num_warps=A_WARPS,
+        )
+    has_band = band is not None
+    _ink_prefill_near[grid](
+        qp, kc, vc, op, lp, band if has_band else q, band_row, part_o, part_m, part_l, qo_meta, kc_start, kc_len, float(sm_scale),
+        SQT=qp.stride(0), SQH=qp.stride(1), SOT=op.stride(0), SOH=op.stride(1),
+        BST=band.stride(0) if has_band else 0, BSH=band.stride(1) if has_band else 0, BW=band.shape[2] if has_band else 0,
+        H=H, G=H // KVH, KVH=KVH, D=D, EXT=ext, BM=BM, BN=B_BN, A_BN=A_BN, HAS_BAND=has_band, HAS_FAR=has_far, SW=sw,
+        num_warps=B_WARPS,
+    )
+    o.copy_(op[:T] if rows is None else op[rows])
+    if lse is not None:
+        lse.copy_(lp[:T] if rows is None else lp[rows])
+    return o
