+# Per-peer stores, the fallback for ``stmc_*`` where NVLink multicast is absent
+# (no NVSwitch, e.g. a bridged H200 NVL node). ``peers`` is the device address of
+# an int64 table of every rank's mailbox base (symmetric memory ``buffer_ptrs``,
+# P2P mapped), ``offset`` the byte offset of the slot in each copy. One
+# ``st.relaxed.sys`` per rank, own rank included, in rank order: every copy
+# receives the bytes the multicast store would have written. All address
+# arithmetic is 64-bit (u64 registers, ``l`` operands).
+def _p2p_store_asm(vector: str, words: int, tp: int) -> str:
+    operands = ", ".join(f"${2 + index}" for index in range(words))
+    stores = "".join(
+        f"ld.global.u64 p2p_base, [$0+{8 * peer}];\n"
+        f"add.u64 p2p_base, p2p_base, $1;\n"
+        f"st.relaxed.sys.global{vector}.b32 [p2p_base], "
+        + (f"{{{operands}}};\n" if words > 1 else f"{operands};\n")
+        for peer in range(tp)
+    )
+    return "{\n.reg .u64 p2p_base;\n" + stores + "}"
+
+
+@dsl_user_op
+def stp2p_bf16x2(
+    peers: Int64, offset: Int64, packed: Uint32, tp: int, *, loc=None, ip=None
+) -> None:
+    _asm(
+        None,
+        [
+            peers.ir_value(loc=loc, ip=ip),
+            offset.ir_value(loc=loc, ip=ip),
+            packed.ir_value(loc=loc, ip=ip),
+        ],
+        _p2p_store_asm("", 1, tp),
+        "l,l,r",
+        side_effects=True,
+        loc=loc,
+        ip=ip,
+    )
+
+
+@dsl_user_op
+def stp2p_bf16x4(
+    peers: Int64, offset: Int64, values, tp: int, *, loc=None, ip=None
+) -> None:
+    words = [values[index].ir_value(loc=loc, ip=ip) for index in range(2)]
+    _asm(
+        None,
+        [peers.ir_value(loc=loc, ip=ip), offset.ir_value(loc=loc, ip=ip), *words],
+        _p2p_store_asm(".v2", 2, tp),
+        "l,l,r,r",
+        side_effects=True,
+        loc=loc,
+        ip=ip,
+    )
+
+
+@dsl_user_op
+def stp2p_bf16x8(
+    peers: Int64, offset: Int64, values, tp: int, *, loc=None, ip=None
+) -> None:
+    words = [values[index].ir_value(loc=loc, ip=ip) for index in range(4)]
+    _asm(
+        None,
+        [peers.ir_value(loc=loc, ip=ip), offset.ir_value(loc=loc, ip=ip), *words],
+        _p2p_store_asm(".v4", 4, tp),
+        "l,l,r,r,r,r",
+        side_effects=True,
+        loc=loc,
+        ip=ip,
+    )
+
